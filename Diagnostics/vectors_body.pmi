; SingleStepTests 8086 runner, on the board. tools/vectors.py streams the
; reference tests over USB serial; every test runs here, on the Pico, through
; Cpu86Run(1), and is checked here: all registers, FLAGS under the reference
; mask, every byte the test touches, and no write anywhere else. The test code
; is vectors_state.pmi + vectors_run.pmi, shared with the desktop program.
EnableExplicit
XIncludeFile "vectors_state.pmi"

Procedure.i RxByte()
  Protected c.i
  c = UsbSerialRead()
  While c < 0
    UsbSerialTask()
    SafetyPet()
    c = UsbSerialRead()
  Wend
  ProcedureReturn c
EndProcedure

Procedure ReportFail(what.i, got.i, want.i)
  GroupFail = GroupFail + 1
  If GroupReported < 6
    GroupReported = GroupReported + 1
    Say("F ") : Num(GroupIndex) : Say(" ") : Say(what)
    Say(" got=") : Hex(got, 5) : Say(" want=") : Hex(want, 5) : Eol()
  EndIf
EndProcedure

Procedure SayGroupName()
  Say(@GroupName(0))
EndProcedure

XIncludeFile "vectors_run.pmi"

Procedure.i Cpu86HookRead(lin.i)
  ProcedureReturn VecHookRead(lin)
EndProcedure

Procedure Cpu86HookWrite(lin.i, v.i)
  VecHookWrite(lin, v)
EndProcedure

Procedure.i Cpu86PortIn(port.i, wide.i)
  ProcedureReturn VecPortIn(port, wide)
EndProcedure

Procedure Cpu86PortOut(port.i, v.i, wide.i)
EndProcedure

Procedure Main()
  SafetyBoot()
  ClockInitKhz(#CLOCK_KHZ)
  TimerInit()
  UsbSerialInit()
  WaitHost()
  VecInit()
  Say("8086 vectors clk_sys kHz=") : Num(ClockSysKhz())
  Say(" timing=") : Num(#CPU_TIMING) : Say(" asm-tail=") : Num(#CPU_ASM_TAIL) : Eol()
  Say("READY") : Eol()
  Repeat
    VecStep()
  ForEver
EndProcedure
