; API, interrupt and memory-map checks, on the board. The checks are
; api_state.pmi + api_checks.pmi, shared with the desktop program.
EnableExplicit
XIncludeFile "api_state.pmi"

Procedure Check(*name.i, got.i, want.i)
  Checks = Checks + 1
  If got <> want
    Failures = Failures + 1
    Say("FAIL ") : Say(*name) : Say(" got=") : Hex(got, 5) : Say(" want=") : Hex(want, 5) : Eol()
  EndIf
EndProcedure

XIncludeFile "api_checks.pmi"

Procedure.i Cpu86HookRead(lin.i)
  ProcedureReturn ApiHookRead(lin)
EndProcedure

Procedure Cpu86HookWrite(lin.i, v.i)
  ApiHookWrite(lin, v)
EndProcedure

Procedure.i Cpu86PortIn(port.i, wide.i)
  ProcedureReturn ApiPortIn(port, wide)
EndProcedure

Procedure Cpu86PortOut(port.i, v.i, wide.i)
EndProcedure

Procedure Main()
  SafetyBoot()
  ClockInitKhz(#CLOCK_KHZ)
  TimerInit()
  UsbSerialInit()
  WaitHost()
  Say("8086 API checks timing=") : Num(#CPU_TIMING) : Say(" asm-tail=") : Num(#CPU_ASM_TAIL) : Eol()
  ApiChecks()
  Say("API checks=") : Num(Checks) : Say(" failures=") : Num(Failures)
  If Failures = 0
    Say(" PASS")
  Else
    Say(" FAIL")
  EndIf
  Eol()
  Repeat
    WaitUs(1000000)
  ForEver
EndProcedure
