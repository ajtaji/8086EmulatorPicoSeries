; On-board checks of what the per-instruction vectors cannot reach: the run
; budget, HLT, the interrupt line with the STI delay, NMI, the trap flag,
; the divide-error interrupt, ROM / unmapped / hook pages, words and
; instructions that cross a page or wrap a segment, self-modifying code,
; prefixes inside one budget step, and PUSH SP.
;
; Guest memory: 0-$FFFF in GuestA, $10000-$10FFF in GuestB (a separate host
; array, so a word across $FFFF/$10000 crosses host memory too), ROM at
; $20000 (SRAM, read-only to the guest), hooks at $30000, the rest unmapped.
EnableExplicit
XIncludeFile "../src/io.pmi"

Global Dim GuestA.l(16384)
Global Dim GuestB.l(1024)
Global Dim RomPage.l(1024)
Global Failures.i, Checks.i, HookReads.i, HookWrites.i, LastWriteLin.i, LastWriteVal.i, Got.i, K.i

Procedure.i Cpu86HookRead(lin.i)
  HookReads = HookReads + 1
  ProcedureReturn (lin & 255) ! $5A
EndProcedure

Procedure Cpu86HookWrite(lin.i, v.i)
  HookWrites = HookWrites + 1
  LastWriteLin = lin
  LastWriteVal = v
EndProcedure

Procedure.i Cpu86PortIn(port.i, wide.i)
  ProcedureReturn port ! $1234
EndProcedure

Procedure Cpu86PortOut(port.i, v.i, wide.i)
EndProcedure

Procedure.i Host(lin.i)
  If lin < $10000
    ProcedureReturn @GuestA(0) + lin
  EndIf
  ProcedureReturn @GuestB(0) + lin - $10000
EndProcedure

Procedure Poke8(lin.i, v.i)
  PokeA(Host(lin), v)
EndProcedure

Procedure.i Peek8(lin.i)
  ProcedureReturn PeekA(Host(lin))
EndProcedure

Procedure.i Peek16(lin.i)
  ProcedureReturn Peek8(lin) | (Peek8(lin + 1) << 8)
EndProcedure

; Up to 8 bytes at lin; -1 ends the list.
Procedure Put(lin.i, b0.i, b1.i, b2.i, b3.i, b4.i, b5.i, b6.i, b7.i)
  If b0 >= 0 : Poke8(lin, b0) : EndIf
  If b1 >= 0 : Poke8(lin + 1, b1) : EndIf
  If b2 >= 0 : Poke8(lin + 2, b2) : EndIf
  If b3 >= 0 : Poke8(lin + 3, b3) : EndIf
  If b4 >= 0 : Poke8(lin + 4, b4) : EndIf
  If b5 >= 0 : Poke8(lin + 5, b5) : EndIf
  If b6 >= 0 : Poke8(lin + 6, b6) : EndIf
  If b7 >= 0 : Poke8(lin + 7, b7) : EndIf
EndProcedure

Procedure Vector(n.i, ip.i)
  Poke8(n * 4, ip & 255) : Poke8(n * 4 + 1, ip >> 8)
  Poke8(n * 4 + 2, 0) : Poke8(n * 4 + 3, 0)
EndProcedure

Procedure Check(*name.i, got.i, want.i)
  Checks = Checks + 1
  If got <> want
    Failures = Failures + 1
    Say("FAIL ") : Say(*name) : Say(" got=") : Hex(got, 5) : Say(" want=") : Hex(want, 5) : Eol()
  EndIf
EndProcedure

; Fresh CPU: all segments 0, SP=$F000, IP=$100, FLAGS=$F002 (IF=0), NOPs at $100.
Procedure Fresh()
  Cpu86Reset()
  For K = 0 To 3
    Cpu86SetSeg(K, 0)
  Next
  R(4) = $F000
  Cpu86SetIP($100)
  For K = $100 To $13F
    Poke8(K, $90)
  Next
EndProcedure

Procedure Main()
  SafetyBoot()
  ClockInitKhz(#CLOCK_KHZ)
  TimerInit()
  UsbSerialInit()
  WaitHost()
  Say("8086 API checks timing=") : Num(#CPU_TIMING) : Say(" asm-tail=") : Num(#CPU_ASM_TAIL) : Eol()
  For K = 0 To 4095
    PokeA(@RomPage(0) + K, K & 255)
  Next
  Cpu86MapNone(0, $100000)
  Cpu86MapRam(0, $10000, @GuestA(0))
  Cpu86MapRam($10000, $1000, @GuestB(0))
  Cpu86MapRom($20000, $1000, @RomPage(0))
  Cpu86MapHook($30000, $1000)
  Vector(0, $530) : Put($530, $47, $CF, -1, -1, -1, -1, -1, -1)      ; INC DI / IRET
  Vector(1, $520) : Put($520, $41, $CF, -1, -1, -1, -1, -1, -1)      ; INC CX / IRET
  Vector(2, $510) : Put($510, $42, $CF, -1, -1, -1, -1, -1, -1)      ; INC DX / IRET
  Vector($20, $500) : Put($500, $43, $CF, -1, -1, -1, -1, -1, -1)    ; INC BX / IRET

  ; Budget.
  Fresh()
  CompilerIf #CPU_TIMING = 0
    Check("run(0)", Cpu86Run(0), 0)
    Check("run(-3)", Cpu86Run(-3), 0)
    Check("run(5)", Cpu86Run(5), 5)
    Check("run(5) ip", Cpu86GetIP(), $105)
  CompilerElse
    Check("run(0)", Cpu86Run(0), 0)
    Got = Cpu86Run(10)           ; NOP is 3 clocks: four NOPs, 12 clocks
    Check("run(10 clocks)", Got, 12)
    Check("run(10 clocks) ip", Cpu86GetIP(), $104)
  CompilerEndIf

  CompilerIf #CPU_TIMING = 0
  ; HLT.
  Fresh()
  Put($100, $F4, -1, -1, -1, -1, -1, -1, -1)
  Check("hlt run", Cpu86Run(10), 1)
  Check("hlt halted", Halted, 1)
  Check("hlt ip", Cpu86GetIP(), $101)
  Check("hlt again", Cpu86Run(10), 0)

  ; Interrupt line, STI delay, acknowledge.
  Fresh()
  Put($100, $FB, -1, -1, -1, -1, -1, -1, -1)                         ; STI, then NOPs
  Cpu86Irq($20)
  Check("irq sti", Cpu86Run(1), 1)
  Check("irq after sti bx", R(3), 0)
  Cpu86Run(1)
  Check("irq delayed one instruction", Cpu86GetIP(), $102)
  Check("irq delayed bx", R(3), 0)
  Cpu86Run(1)
  Check("irq taken bx", R(3), 1)
  Check("irq taken ip", Cpu86GetIP(), $501)
  Check("irq sp", R(4), $F000 - 6)
  Check("irq pushed ip", Peek16($F000 - 6), $102)
  Check("irq pushed cs", Peek16($F000 - 4), 0)
  Check("irq pushed flags", Peek16($F000 - 2), $F202)
  Check("irq IF cleared", Cpu86Flags() & $200, 0)
  Cpu86Run(1)
  Check("iret ip", Cpu86GetIP(), $102)
  Check("iret IF", Cpu86Flags() & $200, $200)
  Cpu86Run(2)
  Check("irq taken once", R(3), 1)

  ; A masked request waits; a cancelled one is never taken.
  Fresh()
  Cpu86Irq($20)
  Check("masked run", Cpu86Run(3), 3)
  Check("masked bx", R(3), 0)
  Cpu86IrqCancel()
  Cpu86SetFlags($F202)
  Cpu86Run(3)
  Check("cancelled bx", R(3), 0)

  ; NMI is taken with IF = 0.
  Fresh()
  Cpu86Nmi()
  Cpu86Run(1)
  Check("nmi dx", R(2), 1)
  Check("nmi ip", Cpu86GetIP(), $511)
  Cpu86Run(1)
  Check("nmi iret ip", Cpu86GetIP(), $100)

  ; Trap flag: POPF sets TF; the trap follows the NEXT instruction; IRET
  ; restores TF without trapping after itself.
  Fresh()
  Put($100, $9C, $58, $0D, $00, $01, $50, $9D, $90)   ; PUSHF POP AX OR AX,100h PUSH AX POPF NOP
  Check("tf setup", Cpu86Run(5), 5)
  Check("tf set", Cpu86Flags() & $100, $100)
  Check("tf run", Cpu86Run(7), 7)
  Check("tf traps", R(1), 2)
  Check("tf ip", Cpu86GetIP(), $10A)

  ; Divide error: INT 0 with the address of the NEXT instruction.
  Fresh()
  Put($100, $F6, $F1, -1, -1, -1, -1, -1, -1)                        ; DIV CL (CL = 0)
  Cpu86Run(2)
  Check("div0 di", R(7), 1)
  Check("div0 ip", Cpu86GetIP(), $531)
  Check("div0 pushed ip", Peek16($F000 - 6), $102)

  ; Hook page: reads and writes reach the hooks.
  Fresh()
  Cpu86SetSeg(3, $3000)
  Put($100, $A0, $10, $00, $A2, $20, $00, -1, -1)                    ; MOV AL,[10h] / MOV [20h],AL
  HookReads = 0 : HookWrites = 0
  Cpu86Run(2)
  Check("hook read value", R(0) & 255, $4A)
  Check("hook reads", HookReads, 1)
  Check("hook writes", HookWrites, 1)
  Check("hook write lin", LastWriteLin, $30020)
  Check("hook write value", LastWriteVal, $4A)

  ; ROM: writes ignored, reads served; unmapped: reads $FF, writes ignored.
  Fresh()
  Cpu86SetSeg(3, $2000)
  Put($100, $C6, $06, $05, $00, $77, $A0, $05, $00)                  ; MOV BYTE [5],77h / MOV AL,[5]
  HookWrites = 0
  Cpu86Run(2)
  Check("rom read", R(0) & 255, 5)
  Check("rom unchanged", PeekA(@RomPage(0) + 5), 5)
  Fresh()
  Cpu86SetSeg(3, $4000)
  Put($100, $A1, $00, $00, $C7, $06, $00, $00, $34)                  ; MOV AX,[0] / MOV WORD [0],..
  Put($108, $12, -1, -1, -1, -1, -1, -1, -1)
  Cpu86Run(2)
  Check("unmapped read", R(0), $FFFF)
  Check("unmapped no hook", HookWrites, 0)

  ; A word across $FFFF/$10000 (two host arrays) and one at offset $FFFF.
  Fresh()
  Cpu86SetSeg(3, $0FFF)
  Put($100, $C7, $06, $0F, $00, $34, $12, $8B, $1E)                  ; MOV WORD [0Fh],1234h / MOV BX,[0Fh]
  Put($108, $0F, $00, -1, -1, -1, -1, -1, -1)
  Cpu86Run(2)
  Check("cross-array low", Peek8($FFFF), $34)
  Check("cross-array high", Peek8($10000), $12)
  Check("cross-array read", R(3), $1234)
  Fresh()
  Cpu86SetSeg(3, $0100)
  Put($100, $C7, $06, $FF, $FF, $CD, $AB, -1, -1)                    ; MOV WORD [FFFFh],ABCDh
  Cpu86Run(1)
  Check("segment wrap low", Peek8($10FFF), $CD)
  Check("segment wrap high", Peek8($1000), $AB)

  ; An instruction across a page boundary, and one across the IP wrap.
  Fresh()
  Cpu86SetIP($0FFE)
  Put($0FFE, $B8, $34, $12, $90, -1, -1, -1, -1)                     ; MOV AX,1234h
  Check("page-cross run", Cpu86Run(2), 2)
  Check("page-cross ax", R(0), $1234)
  Check("page-cross ip", Cpu86GetIP(), $1002)
  Fresh()
  Cpu86SetIP($FFFE)
  Put($FFFE, $B8, $78, -1, -1, -1, -1, -1, -1)                       ; MOV AX,5678h wrapping IP
  Poke8(0, $56) : Poke8(1, $90)
  Check("ip-wrap run", Cpu86Run(2), 2)
  Check("ip-wrap ax", R(0), $5678)
  Check("ip-wrap ip", Cpu86GetIP(), 2)
  Vector(0, $530)

  ; Self-modifying code: the instruction written just ahead runs.
  Fresh()
  Put($100, $C6, $06, $06, $01, $40, $90, $90, -1)                   ; MOV BYTE [106h],40h / NOP / (INC AX)
  Cpu86Run(3)
  Check("self-modify", R(0), 1)

  ; Prefixes belong to their instruction; a REP string instruction is one step.
  Fresh()
  Put($100, $26, $2E, $90, -1, -1, -1, -1, -1)
  Check("prefix run", Cpu86Run(1), 1)
  Check("prefix ip", Cpu86GetIP(), $103)
  Fresh()
  R(1) = 3 : R(6) = $200 : R(7) = $300
  Put($200, 1, 2, 3, -1, -1, -1, -1, -1)
  Put($100, $FC, $F3, $A4, -1, -1, -1, -1, -1)                       ; CLD / REP MOVSB
  Check("rep run", Cpu86Run(2), 2)
  Check("rep cx", R(1), 0)
  Check("rep copy", Peek8($300) | (Peek8($301) << 8) | (Peek8($302) << 16), $030201)

  ; REP MOVS / STOS: overlap at distance 1 (byte and word), a copy across a
  ; page boundary, STOSW into ROM and unmapped pages, STOSW wrapping the segment.
  Fresh()
  R(1) = 5 : R(6) = $200 : R(7) = $201
  Put($200, $AA, 0, 0, 0, 0, 0, 0, -1)
  Put($100, $FC, $F3, $A4, -1, -1, -1, -1, -1)                       ; CLD / REP MOVSB
  Cpu86Run(2)
  Check("rep movsb overlap", Peek8($201) + Peek8($202) + Peek8($203) + Peek8($204) + Peek8($205), 5 * $AA)
  Check("rep movsb overlap end", Peek8($206), 0)
  Fresh()
  R(1) = 2 : R(6) = $300 : R(7) = $301
  Put($300, 1, 2, 3, 4, 0, -1, -1, -1)
  Put($100, $FC, $F3, $A5, -1, -1, -1, -1, -1)                       ; CLD / REP MOVSW
  Cpu86Run(2)
  Check("rep movsw overlap", Peek8($300) | (Peek8($301) << 8) | (Peek8($302) << 16) | (Peek8($303) << 24), $02020101)
  Check("rep movsw overlap last", Peek8($304), 4)
  Fresh()
  For K = 0 To 31
    Poke8($0FF0 + K, K + 1)
  Next
  R(1) = 16 : R(6) = $0FF0 : R(7) = $2FF1
  Put($100, $FC, $F3, $A5, -1, -1, -1, -1, -1)
  Cpu86Run(2)
  Got = 0
  For K = 0 To 31
    If Peek8($2FF1 + K) <> K + 1
      Got = Got + 1
    EndIf
  Next
  Check("rep movsw across pages", Got, 0)
  Check("rep movsw si", R(6), $1010)
  Check("rep movsw di", R(7), $3011)
  Fresh()
  Cpu86SetSeg(0, $2000)
  R(0) = $5A5A : R(1) = 8 : R(7) = $0FF8
  Put($100, $FC, $F3, $AB, -1, -1, -1, -1, -1)                       ; CLD / REP STOSW
  Cpu86Run(2)
  Check("rep stosw rom unchanged", PeekA(@RomPage(0) + $FF8) | (PeekA(@RomPage(0) + $FFF) << 8), $FFF8)
  Check("rep stosw di", R(7), $1008)
  Check("rep stosw cx", R(1), 0)
  Fresh()
  Cpu86SetSeg(0, $0100)
  R(0) = $1234 : R(1) = 3 : R(7) = $FFFE
  Put($100, $FC, $F3, $AB, -1, -1, -1, -1, -1)
  Cpu86Run(2)
  Check("rep stosw wrap 1", Peek16($10FFE), $1234)
  Check("rep stosw wrap 2", Peek16($1000), $1234)
  Check("rep stosw wrap 3", Peek16($1002), $1234)
  Check("rep stosw wrap di", R(7), 4)

  ; PUSH SP pushes the decremented SP; IN reaches the port hook.
  Fresh()
  R(4) = $200
  Put($100, $54, $BA, $00, $03, $ED, -1, -1, -1)                     ; PUSH SP / MOV DX,300h / IN AX,DX
  Cpu86Run(3)
  Check("push sp", Peek16($1FE), $1FE)
  Check("in ax,dx", R(0), $300 ! $1234)
  CompilerEndIf

  Say("API checks=") : Num(Checks) : Say(" failures=") : Num(Failures)
  If Failures = 0
    Say(" PASS")
  Else
    Say(" FAIL")
  EndIf
  Eol()
  Repeat
    WaitUs(1000000)
  ForEver
EndProcedure
