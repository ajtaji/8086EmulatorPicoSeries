  c86_vr = ~c86_va
  PokeA(@R(0) + R8O(c86_m & 7), c86_vr)
  ProcedureReturn 0
  ProcedureReturn 0
EndProcedure
Procedure.i GF6M2()
  c86_t = PageR(c86_ea >> 12)
  If c86_t <> 0
    c86_va = PeekA(c86_t + c86_ea)
  Else
    c86_va = Cpu86Rd8(c86_ea)
  EndIf
  c86_vr = ~c86_va
  c86_t = PageW(c86_ea >> 12)
  If c86_t <> 0
    PokeA(c86_t + c86_ea, c86_vr)
  Else
    Cpu86Wr8(c86_ea, c86_vr)
  EndIf
  ProcedureReturn 0
  ProcedureReturn 0
EndProcedure
Procedure.i GF6R3()
  c86_va = PeekA(@R(0) + R8O(c86_m & 7))
  c86_vb = c86_va
  c86_va = 0
  c86_vr = c86_va - c86_vb
  FC = c86_vr << 55
  FO = ((c86_va ! c86_vb) & (c86_va ! c86_vr)) << 56
  FA = c86_va ! c86_vb
  FZS = (c86_vr << 56) >> 56
  PokeA(@R(0) + R8O(c86_m & 7), c86_vr)
  ProcedureReturn 0
  ProcedureReturn 0
