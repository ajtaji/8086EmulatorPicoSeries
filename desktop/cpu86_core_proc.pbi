Procedure.i Cpu86Run(n.i)
  Protected t.i
  If n <= 0
    ProcedureReturn 0
  EndIf
  If Ready = 0
    For InitIndex = 0 To 255
      t = InitIndex ! (InitIndex >> 4)
      t = t ! (t >> 2)
      t = t ! (t >> 1)
      If t & 1
        Par(InitIndex) = 0
      Else
        Par(InitIndex) = 4
      EndIf
    Next
    R8O(0) = 0
    R8O(1) = 2
    R8O(2) = 4
    R8O(3) = 6
    R8O(4) = 1
    R8O(5) = 3
    R8O(6) = 5
    R8O(7) = 7
    DispP($00) = @Op00()
    DispP($01) = @Op01()
    DispP($02) = @Op02()
    DispP($03) = @Op03()
    DispP($04) = @Op04()
    DispP($05) = @Op05()
    DispP($06) = @Op06()
    DispP($07) = @Op07()
    DispP($08) = @Op08()
    DispP($09) = @Op09()
    DispP($0A) = @Op0A()
    DispP($0B) = @Op0B()
    DispP($0C) = @Op0C()
    DispP($0D) = @Op0D()
    DispP($0E) = @Op0E()
    DispP($0F) = @Op0F()
