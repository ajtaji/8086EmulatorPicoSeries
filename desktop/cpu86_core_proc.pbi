  If c86_t <> 0
    c86_va = PeekA(c86_t + c86_ea)
  Else
    c86_va = Cpu86Rd8(c86_ea)
  EndIf
  c86_vb = PeekA(PIP)
  PIP = PIP + 1
  c86_vr = c86_va & c86_vb
  FC = 0
  FO = 0
  FA = c86_vr
  FZS = (c86_vr << 56) >> 56
