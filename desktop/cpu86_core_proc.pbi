  Charge(4)
  EndIf
  ProcedureReturn 0
  ProcedureReturn 0
EndProcedure
Procedure.i OpD4()
  c86_x = PeekA(PIP + 1)
  PIP = PIP + 2
  If c86_x = 0
    FZS = 0                       ; the 8086 leaves ZF = PF = 1, SF = 0 here
    Cpu86Interrupt(0)
  Else
    c86_va = PeekA(@R(0) + 0)
    PokeA(@R(0) + 1, c86_va / c86_x)
    c86_vr = c86_va % c86_x
    PokeA(@R(0), c86_vr)
  FZS = (c86_vr << 56) >> 56
    FC = 0
    FO = 0
    FA = c86_vr
  EndIf
  ProcedureReturn 0
  ProcedureReturn 0
EndProcedure
Procedure.i OpD5()
  c86_x = PeekA(PIP + 1)
  PIP = PIP + 2
  c86_va = PeekA(@R(0) + 0)
  c86_vb = (PeekA(@R(0) + 1) * c86_x) & 255
  c86_vr = c86_va + c86_vb
  FC = c86_vr << 55
  FO = ((c86_va ! c86_vr) & (c86_vb ! c86_vr)) << 56
  FA = c86_va ! c86_vb
  FZS = (c86_vr << 56) >> 56
  R(0) = c86_vr & 255
  ProcedureReturn 0
  ProcedureReturn 0
EndProcedure
Procedure.i OpD6()
  If FC < 0
    PokeA(@R(0), 255)
  Else
    PokeA(@R(0), 0)
  EndIf
  PIP = PIP + 1
  ProcedureReturn 0
  ProcedureReturn 0
EndProcedure
Procedure.i OpD7()
  c86_eo = (R(3) + PeekA(@R(0))) & $FFFF
  c86_ea = SegD + c86_eo
  c86_t = PageR(c86_ea >> 12)
  If c86_t <> 0
    c86_va = PeekA(c86_t + c86_ea)
  Else
    c86_va = Cpu86Rd8(c86_ea)
  EndIf
  PokeA(@R(0), c86_va)
  PIP = PIP + 1
  ProcedureReturn 0
  ProcedureReturn 0
EndProcedure
