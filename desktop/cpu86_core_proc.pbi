  EndIf
  ProcedureReturn 0
  ProcedureReturn 0
EndProcedure
Procedure.i GFER4()
  c86_va = PeekA(@R(0) + R8O(c86_m & 7))
  c86_vr = c86_va + 1
  FO = (c86_vr & ~c86_va) << 56
  FA = c86_va                 ; AF = bit 4 of FA ^ result (the 1 adds nothing there)
  FZS = (c86_vr << 56) >> 56
  PokeA(@R(0) + R8O(c86_m & 7), c86_vr)
  ProcedureReturn 0
  ProcedureReturn 0
EndProcedure
Procedure.i GFEM4()
  c86_t = PageR(c86_ea >> 12)
  If c86_t <> 0
    c86_va = PeekA(c86_t + c86_ea)
  Else
    c86_va = Cpu86Rd8(c86_ea)
  EndIf
  c86_vr = c86_va + 1
  FO = (c86_vr & ~c86_va) << 56
  FA = c86_va                 ; AF = bit 4 of FA ^ result (the 1 adds nothing there)
  FZS = (c86_vr << 56) >> 56
  c86_t = PageW(c86_ea >> 12)
  If c86_t <> 0
    PokeA(c86_t + c86_ea, c86_vr)
