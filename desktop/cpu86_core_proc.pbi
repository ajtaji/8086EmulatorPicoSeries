    PokeA(c86_t + c86_ea + 1, c86_va >> 8)
  Else
    Cpu86Wr16(SegB(2), c86_eo, c86_va)
  EndIf
  SegV(1) = c86_vb
  SegB(1) = (c86_vb) << 4
  PBase = 0
  PIP = c86_y
  PEnd = 0
  ProcedureReturn 0
  ProcedureReturn 0
