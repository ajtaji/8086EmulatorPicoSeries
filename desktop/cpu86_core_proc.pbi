  SegS = SegB(3)
  Charge(2)
  ProcedureReturn 1
  ProcedureReturn 0
EndProcedure
Procedure.i Op27()
  c86_va = PeekA(@R(0) + 0)
  c86_x = (FC >> 63) & 1
  c86_y = ((FA ! FZS) >> 4) & 1
  c86_vr = c86_va
  FO = 0
  If c86_x
    If (c86_va >= $1A) And (c86_va <= $7F)
      FO = $8000000000000000
    EndIf
  ElseIf (c86_va >= $7A) And (c86_va <= $7F)
    FO = $8000000000000000
  EndIf
  If ((c86_va & 15) > 9) Or c86_y
    c86_vr = (c86_vr + 6) & 255
    FA = $10
  Else
    FA = 0
  EndIf
  c86_cnt = $99
  If c86_y
    c86_cnt = $9F
  EndIf
  If (c86_va > c86_cnt) Or c86_x
    c86_vr = (c86_vr + $60) & 255
    FC = $8000000000000000
  Else
    FC = 0
  EndIf
  PokeA(@R(0), c86_vr)
  FZS = (c86_vr << 56) >> 56
  FA = FA ! c86_vr
  PIP = PIP + 1
  ProcedureReturn 0
  ProcedureReturn 0
EndProcedure
Procedure.i Op2F()
  c86_va = PeekA(@R(0) + 0)
  c86_x = (FC >> 63) & 1
  c86_y = ((FA ! FZS) >> 4) & 1
  c86_vr = c86_va
  FO = 0
  If (c86_x = 0) And (c86_y = 0)
    If (c86_va >= $9A) And (c86_va <= $DF)
      FO = $8000000000000000
    EndIf
  ElseIf c86_x = 0
    If ((c86_va >= $80) And (c86_va <= $85)) Or ((c86_va >= $A0) And (c86_va <= $E5))
      FO = $8000000000000000
    EndIf
  ElseIf c86_y = 0
    If (c86_va >= $80) And (c86_va <= $DF)
      FO = $8000000000000000
    EndIf
  Else
    If (c86_va >= $80) And (c86_va <= $E5)
      FO = $8000000000000000
    EndIf
  EndIf
  If ((c86_va & 15) > 9) Or c86_y
    c86_vr = (c86_vr - 6) & 255
    FA = $10
  Else
    FA = 0
  EndIf
  c86_cnt = $99
  If c86_y
    c86_cnt = $9F
  EndIf
  If (c86_va > c86_cnt) Or c86_x
    c86_vr = (c86_vr - $60) & 255
    FC = $8000000000000000
  Else
    FC = 0
  EndIf
  PokeA(@R(0), c86_vr)
  FZS = (c86_vr << 56) >> 56
  FA = FA ! c86_vr
  PIP = PIP + 1
  ProcedureReturn 0
  ProcedureReturn 0
EndProcedure
Procedure.i Op37()
  c86_va = PeekA(@R(0) + 0)
  If ((c86_va & 15) > 9) Or ((FA ! FZS) & $10)
    PokeA(@R(0) + 1, PeekA(@R(0) + 1) + 1)
    c86_vr = (c86_va + 6) & 255
    FA = $10
    FC = $8000000000000000
  Else
    c86_vr = c86_va
    FA = 0
    FC = 0
  EndIf
  PokeA(@R(0), c86_vr & 15)
  FO = 0
  If (c86_va >= $7A) And (c86_va <= $7F)
    FO = $8000000000000000
  EndIf
  If (c86_va >= $7A) And (c86_va <= $F9)
    FZS = $8000000000000000 | c86_vr
  Else
    FZS = c86_vr
  EndIf
  If c86_vr = 0
    FZS = FZS & $8000000000000000
  EndIf
  FA = FA ! c86_vr
  PIP = PIP + 1
  ProcedureReturn 0
  ProcedureReturn 0
EndProcedure
Procedure.i Op3F()
  c86_va = PeekA(@R(0) + 0)
  c86_y = ((FA ! FZS) >> 4) & 1
  If ((c86_va & 15) > 9) Or c86_y
    c86_vr = (c86_va - 6) & 255
    PokeA(@R(0) + 1, PeekA(@R(0) + 1) - 1)
    FA = $10
    FC = $8000000000000000
  Else
    c86_vr = c86_va
    FA = 0
    FC = 0
  EndIf
  PokeA(@R(0), c86_vr & 15)
  FO = 0
  c86_x = 0
  If c86_y And (c86_va >= $80) And (c86_va <= $85)
    FO = $8000000000000000
  EndIf
  If (c86_y = 0) And (c86_va >= $80)
    c86_x = 1
  EndIf
  If c86_y And ((c86_va <= 5) Or (c86_va >= $86))
    c86_x = 1
  EndIf
  FZS = c86_vr
  If c86_x
    FZS = FZS | $8000000000000000
  EndIf
  If c86_vr = 0
    FZS = FZS & $8000000000000000
  EndIf
  FA = FA ! c86_vr
  PIP = PIP + 1
  ProcedureReturn 0
  ProcedureReturn 0
EndProcedure
Procedure.i Op40()
  c86_va = R(0)
  c86_vr = c86_va + 1
  FO = (c86_vr & ~c86_va) << 48
  FA = c86_va                 ; AF = bit 4 of FA ^ result (the 1 adds nothing there)
  FZS = (c86_vr << 48) >> 48
  R(0) = c86_vr
  PIP = PIP + 1
  ProcedureReturn 0
  ProcedureReturn 0
EndProcedure
Procedure.i Op48()
  c86_va = R(0)
  c86_vr = c86_va - 1
  FO = (c86_va & ~c86_vr) << 48
  FA = c86_va                 ; AF = bit 4 of FA ^ result (the 1 adds nothing there)
  FZS = (c86_vr << 48) >> 48
  R(0) = c86_vr
  PIP = PIP + 1
  ProcedureReturn 0
  ProcedureReturn 0
EndProcedure
