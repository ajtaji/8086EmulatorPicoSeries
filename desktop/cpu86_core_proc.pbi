Procedure.i OpFF()
  c86_m = PeekA(PIP + 1)
  If c86_m < $C0
    CallFunctionFast(EaP(c86_m))
    ProcedureReturn CallFunctionFast(GFFMP((c86_m >> 3) & 7))
  EndIf
  PIP = PIP + 2
  ProcedureReturn CallFunctionFast(GFFRP((c86_m >> 3) & 7))
  ProcedureReturn 0
EndProcedure
Procedure.i GFFR0()
  c86_va = R(c86_m & 7)
  c86_vr = c86_va + 1
  FO = (c86_vr & ~c86_va) << 48
  FA = c86_va                 ; AF = bit 4 of FA ^ result (the 1 adds nothing there)
  FZS = (c86_vr << 48) >> 48
  R(c86_m & 7) = c86_vr
  ProcedureReturn 0
  ProcedureReturn 0
EndProcedure
Procedure.i GFFM0()
  c86_t = PageR(c86_ea >> 12)
  If (~c86_ea << 60) = 0              ; xxxF: maybe a page or segment end
    c86_t = 0
  EndIf
  If c86_t <> 0
    c86_va = PeekA(c86_t + c86_ea) | (PeekA(c86_t + c86_ea + 1) << 8)
  Else
    c86_va = Cpu86Rd16(c86_sb, c86_eo)
  EndIf
  c86_vr = c86_va + 1
  FO = (c86_vr & ~c86_va) << 48
  FA = c86_va                 ; AF = bit 4 of FA ^ result (the 1 adds nothing there)
  FZS = (c86_vr << 48) >> 48
  c86_t = PageW(c86_ea >> 12)
  If (~c86_ea << 60) = 0              ; xxxF: maybe a page or segment end
    c86_t = 0
  EndIf
  If c86_t <> 0
    PokeA(c86_t + c86_ea, c86_vr)
    PokeA(c86_t + c86_ea + 1, c86_vr >> 8)
  Else
    Cpu86Wr16(c86_sb, c86_eo, c86_vr)
  EndIf
  ProcedureReturn 0
  ProcedureReturn 0
EndProcedure
