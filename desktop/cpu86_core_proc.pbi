  FO = ((c86_va ! c86_vr) & (c86_vb ! c86_vr)) << 56
  FA = c86_va ! c86_vb
  FZS = (c86_vr << 56) >> 56
  PokeA(@R(0) + R8O(c86_m & 7), c86_vr)
  ProcedureReturn 0
