Procedure.i OpF6()
  c86_m = PeekA(PIP + 1)
  If c86_m < $C0
    CallFunctionFast(EaP(c86_m))
    ProcedureReturn CallFunctionFast(GF6MP((c86_m >> 3) & 7))
  EndIf
  PIP = PIP + 2
  ProcedureReturn CallFunctionFast(GF6RP((c86_m >> 3) & 7))
  ProcedureReturn 0
EndProcedure
Procedure.i GF6R0()
  c86_va = PeekA(@R(0) + R8O(c86_m & 7))
  c86_vb = PeekA(PIP)
  PIP = PIP + 1
  c86_vr = c86_va & c86_vb
  FC = 0
  FO = 0
  FA = c86_vr
  FZS = (c86_vr << 56) >> 56
  ProcedureReturn 0
  ProcedureReturn 0
EndProcedure
Procedure.i GF6M0()
