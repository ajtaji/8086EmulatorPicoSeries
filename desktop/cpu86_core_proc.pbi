  c86_t = PageW(c86_ea >> 12)
  If (~c86_ea << 60) = 0              ; xxxF: maybe a page or segment end
    c86_t = 0
  EndIf
  If c86_t <> 0
    PokeA(c86_t + c86_ea, c86_vr)
    PokeA(c86_t + c86_ea + 1, c86_vr >> 8)
  Else
    Cpu86Wr16(c86_sb, c86_eo, c86_vr)
  EndIf
  Charge(4)
  EndIf
  ProcedureReturn 0
  ProcedureReturn 0
EndProcedure
Procedure.i GD3R5()
  c86_va = R(c86_m & 7)
  c86_cnt = PeekA(@R(0) + 2)
  If c86_cnt <> 0
    If c86_cnt > 31
      c86_y = 0
    Else
      c86_y = c86_va >> (c86_cnt - 1)
    EndIf
    c86_vr = c86_y >> 1
    FC = c86_y << 63
    FO = (c86_y >> 15) << 63
    FA = c86_vr
    FZS = (c86_vr << 48) >> 48
  R(c86_m & 7) = c86_vr
  Charge(4)
  EndIf
  ProcedureReturn 0
  ProcedureReturn 0
EndProcedure
Procedure.i GD3M5()
