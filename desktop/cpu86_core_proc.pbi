  Else
    c86_va = Cpu86Rd16(SegB(2), c86_eo)
  EndIf
  R(4) = c86_eo + 2
  c86_x = ((PIP - PBase) & $FFFF)
  SegV(1) = c86_va
  SegB(1) = (c86_va) << 4
  PBase = 0
  PIP = c86_x
  PEnd = 0
  ProcedureReturn 0
  ProcedureReturn 0
EndProcedure
Procedure.i Op16()
  PIP = PIP + 1
  c86_eo = (R(4) - 2) & $FFFF
