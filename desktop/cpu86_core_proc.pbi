  SegS = SegB(0)
  Charge(2)
  ProcedureReturn 1
  ProcedureReturn 0
EndProcedure
Procedure.i Op2E()
  SegD = SegB(1)
  SegS = SegB(1)
  Charge(2)
  ProcedureReturn 1
