  EndIf
  Budget = n
  Left = n
PResync:
  SegD = SegB(3)
  SegS = SegB(2)
  Rep = 0
  If EvPend Or Halted Or (FlagsHi & $100)
    If Cpu86Events() = 0
      Goto PDone
    EndIf
  EndIf
  Cpu86Remap()
PNext:
  While CallFunctionFast(DispP(PeekA(PIP)))
    PIP = PIP + 1
    If PIP >= PEndReal
      Cpu86Remap()
    EndIf
    PEnd = 0
  Wend
  Left = Left - 1
  If Left = 0
    Goto PDone
  EndIf
  If PIP >= PEnd
    Goto PResync
  EndIf
  Goto PNext
PDone:
  ProcedureReturn Budget - Left
EndProcedure
