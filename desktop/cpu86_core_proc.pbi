Procedure.i OpE8()
  c86_x = PeekA(PIP + 1) | (PeekA(PIP + 2) << 8)
  PIP = PIP + 3
  c86_va = ((PIP - PBase) & $FFFF)
  c86_eo = (R(4) - 2) & $FFFF
  R(4) = c86_eo
  c86_ea = SegB(2) + c86_eo
  c86_t = PageW(c86_ea >> 12)
  If (~c86_ea << 60) = 0              ; xxxF: maybe a page or segment end
    c86_t = 0
  EndIf
  If c86_t <> 0
    PokeA(c86_t + c86_ea, c86_va)
    PokeA(c86_t + c86_ea + 1, c86_va >> 8)
  Else
    Cpu86Wr16(SegB(2), c86_eo, c86_va)
  EndIf
  PIP = PBase + ((c86_va + c86_x) & $FFFF)
  If PIP < PStart
    PEnd = 0
  EndIf
  ProcedureReturn 0
  ProcedureReturn 0
EndProcedure
Procedure.i OpE9()
  c86_x = PeekA(PIP + 1) | (PeekA(PIP + 2) << 8)
  PIP = PIP + 3
  c86_x = (((PIP - PBase) & $FFFF) + c86_x) & $FFFF
  PIP = PBase + c86_x
  If PIP < PStart
    PEnd = 0
  EndIf
  ProcedureReturn 0
  ProcedureReturn 0
EndProcedure
Procedure.i OpEA()
  c86_x = PeekA(PIP + 1) | (PeekA(PIP + 2) << 8)
  c86_y = PeekA(PIP + 3) | (PeekA(PIP + 4) << 8)
  SegV(1) = c86_y
  SegB(1) = (c86_y) << 4
  PBase = 0
  PIP = c86_x
  PEnd = 0
  ProcedureReturn 0
  ProcedureReturn 0
EndProcedure
Procedure.i OpEB()
  PIP = PIP + 2 + PeekB(PIP + 1)
  If PIP < PStart
    PEnd = 0
  EndIf
  ProcedureReturn 0
  ProcedureReturn 0
