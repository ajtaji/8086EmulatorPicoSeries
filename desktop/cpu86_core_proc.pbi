Procedure.i GD3R7()
  c86_va = R(c86_m & 7)
  c86_cnt = PeekA(@R(0) + 2)
  If c86_cnt <> 0
    c86_y = (c86_va << 48) >> 48
    If c86_cnt > 31
      c86_cnt = 31
    EndIf
    c86_y = c86_y >> (c86_cnt - 1)
    c86_vr = (c86_y >> 1) & $FFFF
    FC = c86_y << 63
    FO = 0
    FA = c86_vr
    FZS = (c86_vr << 48) >> 48
  R(c86_m & 7) = c86_vr
  Charge(4)
  EndIf
