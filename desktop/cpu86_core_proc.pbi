    c86_va = PeekA(c86_t + c86_ea) | (PeekA(c86_t + c86_ea + 1) << 8)
  Else
    c86_va = Cpu86Rd16(c86_sb, c86_eo)
  EndIf
  c86_cnt = PeekA(@R(0) + 2)
  If c86_cnt <> 0
    If c86_cnt > 31
      c86_y = 0
    Else
      c86_y = c86_va >> (c86_cnt - 1)
    EndIf
    c86_vr = c86_y >> 1
    FC = c86_y << 63
    FO = (c86_y >> 15) << 63
    FA = c86_vr
    FZS = (c86_vr << 48) >> 48
  c86_t = PageW(c86_ea >> 12)
  If (~c86_ea << 60) = 0              ; xxxF: maybe a page or segment end
    c86_t = 0
  EndIf
  If c86_t <> 0
    PokeA(c86_t + c86_ea, c86_vr)
