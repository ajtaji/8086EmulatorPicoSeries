    c86_va = PeekA(c86_t + c86_ea) | (PeekA(c86_t + c86_ea + 1) << 8)
  Else
    c86_va = Cpu86Rd16(c86_sb, c86_eo)
  EndIf
  c86_cnt = PeekA(@R(0) + 2)
  If c86_cnt <> 0
    c86_y = (c86_va << 48) >> 48
    If c86_cnt > 31
      c86_cnt = 31
    EndIf
    c86_y = c86_y >> (c86_cnt - 1)
    c86_vr = (c86_y >> 1) & $FFFF
    FC = c86_y << 63
    FO = 0
    FA = c86_vr
    FZS = (c86_vr << 48) >> 48
  c86_t = PageW(c86_ea >> 12)
  If (~c86_ea << 60) = 0              ; xxxF: maybe a page or segment end
    c86_t = 0
  EndIf
  If c86_t <> 0
    PokeA(c86_t + c86_ea, c86_vr)
    PokeA(c86_t + c86_ea + 1, c86_vr >> 8)
  Else
    Cpu86Wr16(c86_sb, c86_eo, c86_vr)
