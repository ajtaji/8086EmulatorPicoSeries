Procedure.i GF6R4()
  c86_vb = PeekA(@R(0) + R8O(c86_m & 7))
  c86_vr = PeekA(@R(0)) * c86_vb
  If Rep
    c86_vr = 0 - c86_vr
  EndIf
  R(0) = c86_vr
  c86_x = (c86_vr >> 8) & $FF
  FZS = (c86_x << 56) >> 56
  If c86_x <> 0
    FC = $8000000000000000
    FO = $8000000000000000
  Else
    FC = 0
    FO = 0
  EndIf
  FA = FZS
  ProcedureReturn 0
  ProcedureReturn 0
EndProcedure
Procedure.i GF6M4()
  c86_t = PageR(c86_ea >> 12)
  If c86_t <> 0
    c86_vb = PeekA(c86_t + c86_ea)
  Else
    c86_vb = Cpu86Rd8(c86_ea)
  EndIf
  c86_vr = PeekA(@R(0)) * c86_vb
  If Rep
    c86_vr = 0 - c86_vr
  EndIf
  R(0) = c86_vr
  c86_x = (c86_vr >> 8) & $FF
  FZS = (c86_x << 56) >> 56
  If c86_x <> 0
    FC = $8000000000000000
    FO = $8000000000000000
  Else
    FC = 0
    FO = 0
  EndIf
  FA = FZS
  ProcedureReturn 0
  ProcedureReturn 0
EndProcedure
Procedure.i GF6R5()
  c86_vb = PeekA(@R(0) + R8O(c86_m & 7))
  c86_vr = PeekB(@R(0)) * ((c86_vb << 56) >> 56)
  If Rep
    c86_vr = 0 - c86_vr
  EndIf
  R(0) = c86_vr
  c86_x = (c86_vr << 56) >> 56
  FZS = (c86_vr << 48) >> 56
  If c86_x <> c86_vr
    FC = $8000000000000000
    FO = $8000000000000000
  Else
    FC = 0
    FO = 0
  EndIf
  FA = FZS
  ProcedureReturn 0
  ProcedureReturn 0
EndProcedure
Procedure.i GF6M5()
  c86_t = PageR(c86_ea >> 12)
  If c86_t <> 0
    c86_vb = PeekA(c86_t + c86_ea)
  Else
    c86_vb = Cpu86Rd8(c86_ea)
  EndIf
  c86_vr = PeekB(@R(0)) * ((c86_vb << 56) >> 56)
  If Rep
    c86_vr = 0 - c86_vr
  EndIf
  R(0) = c86_vr
  c86_x = (c86_vr << 56) >> 56
  FZS = (c86_vr << 48) >> 56
  If c86_x <> c86_vr
