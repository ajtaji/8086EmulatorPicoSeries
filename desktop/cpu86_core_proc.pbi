  Else
    c86_vb = Cpu86Rd16(c86_sb, c86_eo)
  EndIf
  c86_va = SegV(1)
  c86_eo = (R(4) - 2) & $FFFF
  R(4) = c86_eo
  c86_ea = SegB(2) + c86_eo
  c86_t = PageW(c86_ea >> 12)
  If (~c86_ea << 60) = 0              ; xxxF: maybe a page or segment end
    c86_t = 0
