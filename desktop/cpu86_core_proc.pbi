  c86_vb = PeekA(PIP + 1) | (PeekA(PIP + 2) << 8)
  PIP = PIP + 3
  c86_vr = c86_va ! c86_vb
  FC = 0
  FO = 0
  FA = c86_vr
  FZS = (c86_vr << 48) >> 48
  R(0) = c86_vr
  ProcedureReturn 0
  ProcedureReturn 0
EndProcedure
Procedure.i Op38()
  c86_m = PeekA(PIP + 1)
  If c86_m < $C0
    CallFunctionFast(EaP(c86_m))
    Goto Op38M
  EndIf
  PIP = PIP + 2
  c86_va = PeekA(@R(0) + R8O(c86_m & 7))
  c86_vb = PeekA(@R(0) + R8O((c86_m >> 3) & 7))
  c86_vr = c86_va - c86_vb
  FC = c86_vr << 55
  FO = ((c86_va ! c86_vb) & (c86_va ! c86_vr)) << 56
  FA = c86_va ! c86_vb
  FZS = (c86_vr << 56) >> 56
  ProcedureReturn 0
Op38M:
  c86_t = PageR(c86_ea >> 12)
  If c86_t <> 0
    c86_va = PeekA(c86_t + c86_ea)
  Else
    c86_va = Cpu86Rd8(c86_ea)
  EndIf
  c86_vb = PeekA(@R(0) + R8O((c86_m >> 3) & 7))
  c86_vr = c86_va - c86_vb
  FC = c86_vr << 55
  FO = ((c86_va ! c86_vb) & (c86_va ! c86_vr)) << 56
  FA = c86_va ! c86_vb
  FZS = (c86_vr << 56) >> 56
  ProcedureReturn 0
  ProcedureReturn 0
EndProcedure
