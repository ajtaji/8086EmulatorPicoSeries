Procedure.i Op06()
  PIP = PIP + 1
  c86_eo = (R(4) - 2) & $FFFF
  R(4) = c86_eo
  c86_ea = SegB(2) + c86_eo
  c86_t = PageW(c86_ea >> 12)
  If (~c86_ea << 60) = 0              ; xxxF: maybe a page or segment end
    c86_t = 0
  EndIf
  If c86_t <> 0
    PokeA(c86_t + c86_ea, SegV(0))
    PokeA(c86_t + c86_ea + 1, SegV(0) >> 8)
  Else
    Cpu86Wr16(SegB(2), c86_eo, SegV(0))
  EndIf
  ProcedureReturn 0
  ProcedureReturn 0
EndProcedure
Procedure.i Op07()
