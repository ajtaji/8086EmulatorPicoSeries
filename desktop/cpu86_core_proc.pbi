Procedure.i OpE0()
  R(1) = R(1) - 1
  If (R(1) <> 0) And ((FZS << 47) <> 0)
  PIP = PIP + 2 + PeekB(PIP + 1)
  If PIP < PStart
    PEnd = 0
  EndIf
  Charge(12)
  Else
    PIP = PIP + 2
  EndIf
  ProcedureReturn 0
  ProcedureReturn 0
EndProcedure
