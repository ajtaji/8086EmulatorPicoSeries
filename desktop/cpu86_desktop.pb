; Intel 8086 emulator for the desktop: the same 8086 core as the Pico build
; (generated by tools/gen_cpu.py from the same handlers), in PureBasic, with a
; Neon Arcade Display Engine front end.
;
;   cpu86_desktop.exe                  the window
;   cpu86_desktop.exe <file.com>       the window, with a program loaded
;   cpu86_console.exe --test [stream]  the board's test suites, in a console
;                                      (stream: a file from tools/vectors.py --out;
;                                      default ../Diagnostics/vectors-bin/all.bin)
;   cpu86_console.exe --bench          instructions per second, in a console
;   cpu86_console.exe --run <file.com> run a program, print its console output
;   cpu86_run.exe                      the same console modes (not --pc) built with
;                                      /CONSTANT CPU86_LEAN=1: no engine, no window, no
;                                      PC machine - it starts in milliseconds, where the
;                                      engine's libraries cost seconds a launch
;   cpu86_console.exe --com <file> [--seg hex] [--max n] [--dump file]
;                                      the compiler gates' runner: bare CPU, 1 MB RAM,
;                                      E9h out = stdout, F4h out = exit; stops on HLT,
;                                      a jump to itself or the budget (see GateMain);
;                                      a self-jump is seen between 10,000-instruction
;                                      slices, so its instr= includes the spinning
; Window options (any order, with or without a program):
;   --show-tests        run the test suites as soon as the window is up
;   --run               start the loaded program running
;   --screenshot <png>  save the window's own picture after two seconds and close
;   --pc                the PC machine
;   --mute              the PC machine without sound
;
; Build with desktop/build.ps1 (x64, C back end, /DPIAWARE, /OPTIMIZER).

; #CPU_TIMING: 0 (cpu86_console.exe: the budget counts instructions, for --test,
; --bench and the gates) or 1 (cpu86_desktop.exe and cpu86_pc.exe, built with
; /CONSTANT CPU_TIMING=1: the budget counts 8086 clocks, which the PC machine's
; video and timer need).
CompilerIf Not Defined(CPU_TIMING, #PB_Constant)
  #CPU_TIMING = 0
CompilerEndIf
CompilerIf Not Defined(CPU86_LEAN, #PB_Constant)
  #CPU86_LEAN = 0
CompilerEndIf
EnableExplicit

; The engine first: the test code's globals have plain names (K, Checks...)
; that the engine's procedures use as locals.
CompilerIf Not Defined(GL_ENGINE_DIR$, #PB_Constant)
  #GL_ENGINE_DIR$ = "../../Neon-Arcade-Dispay-Engine/"   ; github.com/ajtaji/Neon-Arcade-Dispay-Engine, cloned beside this repository
CompilerEndIf
CompilerIf #CPU86_LEAN = 0
XIncludeFile #GL_ENGINE_DIR$ + "GlTypes.pbi"
XIncludeFile #GL_ENGINE_DIR$ + "GlUtilities.pbi"
XIncludeFile #GL_ENGINE_DIR$ + "GlMath.pbi"
XIncludeFile #GL_ENGINE_DIR$ + "GlSpriteFunctions.pbi"
XIncludeFile #GL_ENGINE_DIR$ + "GlUI.pbi"
XIncludeFile #GL_ENGINE_DIR$ + "GlUIChrome.pbi"
CompilerEndIf

; Dispatch: labels-as-values (the default), or with /CONSTANT CPU86_PROCTABLE=1
; the procedure-table core (cpu86_core_proc.pbi), kept to measure the two.
CompilerIf Defined(CPU86_PROCTABLE, #PB_Constant)
  XIncludeFile "cpu86_core_proc.pbi"
  #DISPATCH_NAME$ = "procedure-table dispatch"
CompilerElse
  XIncludeFile "cpu86_core.pbi"
  #DISPATCH_NAME$ = "labels-as-values dispatch"
CompilerEndIf
XIncludeFile "tests.pbi"
XIncludeFile "machine.pbi"
CompilerIf #CPU86_LEAN = 0
XIncludeFile "controls.pbi"
XIncludeFile "pcmachine.pbi"
CompilerEndIf
XIncludeFile "hooks.pbi"
XIncludeFile "disasm.pbi"

#STREAM_DEFAULT$ = "../Diagnostics/vectors-bin/all.bin"

; ---------------------------------------------------------------------------
; Console modes
; ---------------------------------------------------------------------------
Global DefaultStream$

Procedure.s StreamPath(arg.s)
  If arg <> "" : ProcedureReturn arg : EndIf
  ProcedureReturn DefaultStream$
EndProcedure

; The board's suites on the desktop core: API checks, then the reference tests.
Procedure.i RunAllTests(stream.s)
  Protected failed.i, f.i, passed.i, t.q
  TestLog$ = "" : TestLine$ = ""
  If RunApiChecks() <> 0 : failed + 1 : EndIf
  t = ElapsedMilliseconds()
  Say("SingleStepTests 8086 from " + GetFilePart(stream)) : Eol()
  f = RunVectorFile(stream, @passed)
  If f <> 0 : failed + 1 : EndIf
  If f >= 0
    Say("desktop core: " + Str(passed) + " reference tests passed, " + Str(f) + " failed, in " + StrF((ElapsedMilliseconds() - t) / 1000.0, 1) + " s") : Eol()
  EndIf
  ; The summary first: what passed, then the per-file detail below it.
  Protected sum.s, i.i, line.s
  For i = 1 To CountString(TestLog$, #LF$)
    line = StringField(TestLog$, i, #LF$)
    If FindString(line, "API checks=") Or FindString(line, "TOTAL ") Or FindString(line, "desktop core:") Or Mid(line, 1, 2) = "F " Or Mid(line, 1, 4) = "FAIL"
      sum + line + #LF$
    EndIf
  Next
  TestLog$ = sum + "----" + #LF$ + TestLog$
  MachineReset()
  ProcedureReturn failed
EndProcedure

Procedure BenchOne(name.s, hex.s, si.i = 0, di.i = 0)
  Protected i.i, t.q, s.i
  MachineLoadHex(hex, name)
  R(6) = si : R(7) = di
  t = ElapsedMilliseconds()
  For i = 1 To 100
    s + Cpu86Run(1000000)
    If Halted : MachineReset() : R(6) = si : R(7) = di : EndIf
  Next
  t = ElapsedMilliseconds() - t
  If t < 1 : t = 1 : EndIf
  PrintN(LSet(name, 22) + RSet(StrF(s / t / 1000.0, 1), 7) + " M instructions/s  (" + Str(s) + " in " + Str(t) + " ms)")
EndProcedure

Procedure BenchRep()
  Protected t.q, i.i, k.i
  MachineLoadHex("BA4000FCBE0040BF00C0B90010F3A54A75F1F4", "rep movsw")
  t = ElapsedMilliseconds()
  For k = 1 To 200
    MachineReset()
    Cpu86Run(1000000)
  Next
  t = ElapsedMilliseconds() - t
  If t < 1 : t = 1 : EndIf
  PrintN(LSet("rep movsw", 22) + RSet(StrF(200.0 * 64 * 8192 / t / 1000.0, 1), 7) + " MB/s")
EndProcedure

; --com <file> | --raw <file> --at <linear hex> --entry SEG:OFF, with --seg <hex>
; (default 0050), --max <instructions>, --dump <file>: the runner the PureMetal
; 8086 back end's gates use. Bare CPU, the whole 1 MB as RAM, no BIOS, no ROM.
Procedure.i GateMain()
  Protected i.i, a.s, file.s, raw.i, seg.i = $50, at.i = -1, entry.s, maxn.q = 1000000000, dump.s
  Protected f.i, n.i, ran.i, count.q, why.s, chunk.i, cs.i, ip.i, lin.i, b0.i, b1.i, b2.i, t.q
  Protected pc.i, frames.i = 600, shot.s, *img, fr.i, ln.i, keys.s, tone.i, k.i
  For i = 0 To CountProgramParameters() - 1
    a = LCase(ProgramParameter(i))
    Select a
      Case "--com" : i + 1 : file = ProgramParameter(i)
      Case "--raw" : i + 1 : file = ProgramParameter(i) : raw = 1
      Case "--seg" : i + 1 : seg = Val("$" + ProgramParameter(i)) & $FFFF
      Case "--at" : i + 1 : at = Val("$" + ProgramParameter(i)) & $FFFFF
      Case "--entry" : i + 1 : entry = ProgramParameter(i)
      Case "--max" : i + 1 : maxn = Val(ProgramParameter(i))
      Case "--dump" : i + 1 : dump = ProgramParameter(i)
      Case "--pc" : pc = 1
      Case "--frames" : i + 1 : frames = Val(ProgramParameter(i))
      Case "--screenshot" : i + 1 : shot = ProgramParameter(i)
      Case "--keys" : i + 1 : keys = ProgramParameter(i)
      CompilerIf #CPU86_LEAN = 0
      Case "--halfcheck" : PcHalfCheck = 1
      CompilerEndIf
      Case "--portlog" : i + 1 : PortLogFrom = Val(StringField(ProgramParameter(i), 1, ":")) : PortLogLeft = Val(StringField(ProgramParameter(i), 2, ":"))
    EndSelect
  Next
  If pc And (#CPU_TIMING = 0 Or #CPU86_LEAN)
    PrintN("--pc needs the clock-counted build with the PC machine: run cpu86_pc.exe.") : ProcedureReturn 3
  EndIf
  f = ReadFile(#PB_Any, file)
  If f = 0
    PrintN("Cannot read the program file '" + file + "'.") : ProcedureReturn 2
  EndIf
  n = Lof(f)
  CompilerIf #CPU86_LEAN = 0
  If pc
    ; The PC machine (pc86.pmi), headless: frames of 262 scanlines until an OUT F4h,
    ; a HLT with IF = 0, or --frames (default 600 = 10 s of machine time).
    *img = AllocateMemory(n + 1)
    ReadData(f, *img, n)
    CloseFile(f)
    MachineKind = 1 : GateMode = 1 : GateExit = 0 : TestMode = 0
    PcStart(*img, n)
    FreeMemory(*img)
    For k = 1 To CountString(keys, ",") + 1          ; --keys 1E,9E: set-1 scan codes, in order
      If Trim(StringField(keys, k, ",")) <> "" : Pc86Key(Val("$" + Trim(StringField(keys, k, ",")))) : EndIf
    Next
    t = ElapsedMilliseconds()
    why = "frames"
    For fr = 1 To frames
      For ln = 1 To #PC86_LINES
        count + PcRunLine()
        If SpkFreq((PcLineNo + #PC86_LINES - 1) % #PC86_LINES) > tone : tone = SpkFreq((PcLineNo + #PC86_LINES - 1) % #PC86_LINES) : EndIf
        If GateExit : Break : EndIf
        If Halted And (Cpu86Flags() & $200) = 0 : Break : EndIf
      Next
      If GateExit : why = "exit=" + Str(GateExitCode) : Break : EndIf
      If Halted And (Cpu86Flags() & $200) = 0 : why = "hlt" : Break : EndIf
    Next
    PrintN("")
    PrintN("STOP " + why + " frames=" + Str(PcFrames) + " clocks=" + Str(PcClocks) + " ms=" + Str(ElapsedMilliseconds() - t))
    PrintN("CS=" + H4(Cpu86GetSeg(1)) + " DS=" + H4(Cpu86GetSeg(3)) + " ES=" + H4(Cpu86GetSeg(0)) + " SS=" + H4(Cpu86GetSeg(2)) +
           " IP=" + H4(Cpu86GetIP()) + " SP=" + H4(R(4)) + " AX=" + H4(R(0)) + " BX=" + H4(R(3)) + " CX=" + H4(R(1)) +
           " DX=" + H4(R(2)) + " SI=" + H4(R(6)) + " DI=" + H4(R(7)) + " BP=" + H4(R(5)) + " FLAGS=" + H4(Cpu86Flags()))
    PrintN("PIC IMR=" + H2(PicImr) + " ISR=" + H2(PicIsr) + " base=" + H2(PicBase) + "  PIT0 reload=" + Str(PitReload(0)) +
           " mode=" + Str(PitMode(0)) + "  CGA mode=" + H2(PcMode) + " colour=" + H2(PcColor) + "  highest tone=" + Str(tone) + " Hz")
    If PcHalfCheck
      PrintN("HALFCHECK lines=" + Str(PcHalfLines) + " differing=" + Str(PcHalfBad) + " " + PcHalfFirst)
      If PcHalfBad : ProcedureReturn 4 : EndIf
    EndIf
    If shot <> ""
      If PcSavePng(shot) = 0 : PrintN("Cannot write the picture '" + shot + "'.") : ProcedureReturn 2 : EndIf
    EndIf
    If dump <> ""
      f = CreateFile(#PB_Any, dump)
      If f = 0 : PrintN("Cannot write the dump file '" + dump + "'.") : ProcedureReturn 2 : EndIf
      WriteData(f, *MachineRam, $A0000)
      WriteData(f, *PcVramMem, $4000)
      CloseFile(f)
    EndIf
    ProcedureReturn 0
  EndIf
  CompilerEndIf
  MachineBare()
  GateMode = 1 : GateExit = 0 : TestMode = 0
  Cpu86Reset()
  If raw
    If at < 0 Or entry = ""
      CloseFile(f) : PrintN("--raw needs --at <linear hex> and --entry SEG:OFF.") : ProcedureReturn 2
    EndIf
    If at + n > $100000 : n = $100000 - at : EndIf
    ReadData(f, *MachineRam + at, n)
    cs = Val("$" + StringField(entry, 1, ":")) & $FFFF
    ip = Val("$" + StringField(entry, 2, ":")) & $FFFF
    For i = 0 To 3 : Cpu86SetSeg(i, cs) : Next
  Else
    lin = seg * 16 + $100
    If lin + n > $100000 : n = $100000 - lin : EndIf
    ReadData(f, *MachineRam + lin, n)
    For i = 0 To 3 : Cpu86SetSeg(i, seg) : Next
    ip = $100
  EndIf
  CloseFile(f)
  R(4) = $FFFE
  Cpu86SetIP(ip)
  t = ElapsedMilliseconds()
  why = "budget"
  While count < maxn
    chunk = 10000
    If maxn - count < chunk : chunk = maxn - count : EndIf
    ran = Cpu86Run(chunk)
    If GateExit
      count + GateExitAt
      why = "exit=" + Str(GateExitCode) : Break
    EndIf
    count + ran
    If Halted
      why = "hlt" : If Cpu86Flags() & $200 : why + " (IF=1)" : EndIf
      Break
    EndIf
    lin = (SegB(1) + Cpu86GetIP()) & $FFFFF
    b0 = PeekA(*MachineRam + lin) : b1 = PeekA(*MachineRam + ((lin + 1) & $FFFFF)) : b2 = PeekA(*MachineRam + ((lin + 2) & $FFFFF))
    If (b0 = $EB And b1 = $FE) Or (b0 = $E9 And b1 = $FD And b2 = $FF)
      why = "selfjump" : Break
    EndIf
    If ran = 0 : Break : EndIf
  Wend
  PrintN("")
  PrintN("STOP " + why + " instr=" + Str(count) + " ms=" + Str(ElapsedMilliseconds() - t))
  PrintN("CS=" + H4(Cpu86GetSeg(1)) + " DS=" + H4(Cpu86GetSeg(3)) + " ES=" + H4(Cpu86GetSeg(0)) + " SS=" + H4(Cpu86GetSeg(2)) +
         " IP=" + H4(Cpu86GetIP()) + " SP=" + H4(R(4)) + " AX=" + H4(R(0)) + " BX=" + H4(R(3)) + " CX=" + H4(R(1)) +
         " DX=" + H4(R(2)) + " SI=" + H4(R(6)) + " DI=" + H4(R(7)) + " BP=" + H4(R(5)) + " FLAGS=" + H4(Cpu86Flags()))
  If dump <> ""
    f = CreateFile(#PB_Any, dump)
    If f = 0 : PrintN("Cannot write the dump file '" + dump + "'.") : ProcedureReturn 2 : EndIf
    WriteData(f, *MachineRam, $100000)
    CloseFile(f)
  EndIf
  ProcedureReturn 0
EndProcedure

Procedure.i ConsoleMain()
  Protected arg.s = LCase(ProgramParameter(0)), t.q
  If arg = "--com" Or arg = "--raw"
    OpenConsole()
    ProcedureReturn GateMain()
  ElseIf arg = "--test"
    OpenConsole()
    TestConsole = 1
    ProcedureReturn Bool(RunAllTests(StreamPath(ProgramParameter(1))) <> 0)
  ElseIf arg = "--bench"
    OpenConsole()
    If #CPU_TIMING
      PrintN("This is the clock-counted build: --bench measures instructions, run cpu86_console.exe --bench.")
      ProcedureReturn 3
    EndIf
    PrintN("8086 desktop core, " + #DISPATCH_NAME$ + ", 100 x 1,000,000 instructions per mix")
    BenchOne("register/branch", "4975FDEBFB")
    BenchOne("alu", "01D831C2D1E011D329C647EBF3")
    BenchOne("memory", "8B0401058B5C02895D0283C60483C70481E6FF3F81CE004081E7FF3F81CF0080EBDE", $4000, $8000)
    BenchOne("call/stack", "5053E804005B58EBF740C3")
    BenchRep()
    ProcedureReturn 0
  ElseIf arg = "--run"
    OpenConsole()
    If MachineLoadFile(ProgramParameter(1)) = 0
      PrintN("Cannot read " + ProgramParameter(1)) : ProcedureReturn 2
    EndIf
    t = ElapsedMilliseconds()
    While MachineExited = 0 And Halted = 0 And ElapsedMilliseconds() - t < 10000
      Cpu86Run(1000000)
    Wend
    Print(MachineConsole$)
    PrintN("[exit code " + Str(MachineExitCode) + ", " + Str(ElapsedMilliseconds() - t) + " ms]")
    ProcedureReturn MachineExitCode
  EndIf
  ProcedureReturn -1
EndProcedure

CompilerIf #CPU86_LEAN
; cpu86_run.exe: the console modes only.
DefaultStream$ = GetPathPart(ProgramFilename()) + #STREAM_DEFAULT$
MachineMap()
MachineReset()
Define rc.i = ConsoleMain()
If rc < 0
  OpenConsole()
  PrintN("cpu86_run.exe --com <file> [--seg hex] [--max n] [--dump file] | --raw <file> --at <lin> --entry SEG:OFF | --run <file.com> | --test [stream] | --bench")
  rc = 3
EndIf
End rc
CompilerElse
; ---------------------------------------------------------------------------
; The window
; ---------------------------------------------------------------------------
Global Win.i, Gl.i
Global Running.i, BreakAt.i = -1, BreakText.String, BreakCaret.i
Global Status$ = "Load a .COM program, or press Run tests."
Global RateShown.d, RateWindowCount.i, RateWindowStart.q, Executed.q
Global DisTop.i, MemTab.i, MemTop.i, LogTab.i, LogTop.i
Global Wheel.i, KeyCode.i, KeyChar.i
Global TestsRun.i, TestsFailed.i, ShotPath$, ShotFrames.i
Global AddrText.String, AddrCaret.i, MemBase.i

; Where each control was last drawn (canvas units = physical pixels), for --pointer-test.
Structure CtlRect
  x.f : y.f : w.f : h.f
EndStructure
Global NewMap Ctl.CtlRect()
Global SynthOn.i, SynthClicked$, DisRowAdr.i = -1
Global FullScreen.i                       ; full screen (below); the toolbar's button toggles it
Declare WindowAction(action.i)
Procedure CtlSet(name$, x.f, y.f, w.f, h.f)
  Ctl(name$)\x = x : Ctl()\y = y : Ctl()\w = w : Ctl()\h = h
EndProcedure
; Neon_Button, remembering where it was drawn under a fixed name. Under
; --pointer-test a press is recorded and its action is not taken.
Procedure.b Btn(name$, x.f, y.f, w.f, h.f, label.s, lit.b = #False, enabled.b = #True)
  CtlSet(name$, x, y, w, h)
  If Neon_Button(x, y, w, h, label, lit, enabled)
    If SynthOn : SynthClicked$ = name$ : ProcedureReturn #False : EndIf
    ProcedureReturn #True
  EndIf
  ProcedureReturn #False
EndProcedure

Procedure ResetProgram()
  If MachineKind = 1
    PcStart(*MachineImage, MachineImageLen)
    MachineExited = 0 : MachineExitCode = 0
  Else
    MachineReset()
  EndIf
EndProcedure

Procedure.i LoadProgram(path.s)
  If MachineLoadFile(path) = 0 : ProcedureReturn 0 : EndIf
  If MachineKind = 1 : ResetProgram() : EndIf
  ProcedureReturn 1
EndProcedure

Procedure.s LoadText()
  If MachineKind = 1 : ProcedureReturn " at 0050:0100 on the PC machine." : EndIf
  ProcedureReturn " at 1000:0100."
EndProcedure

Procedure StepOne()
  Executed + Cpu86Run(1)
EndProcedure

Procedure.s StateText()
  If MachineExited : ProcedureReturn "exited (code " + Str(MachineExitCode) + ")" : EndIf
  If Halted : ProcedureReturn "halted" : EndIf
  If Running : ProcedureReturn "running" : EndIf
  ProcedureReturn "stopped"
EndProcedure

; Runs for about budgetMs of wall time, stopping at the breakpoint, at HLT and
; when the program exits.
Global PcOwedMs.d, PcLastMs.q           ; silent PC: wall-clock time owed to the machine

Procedure RunFor(budgetMs.i)
  Protected t0.q = ElapsedMilliseconds(), ran.i, k.i, ln.i, n.i, silent.i
  If MachineKind = 1
    Cpu86RepYield = 1                 ; the test runners turn it off
    ; With sound the queue paces the frames; without it (--mute, or no sound
    ; device) the clock does - a frame each 16.688 ms, whatever the screen's refresh.
    silent = Bool(PcSndOpen = 0 Or PcSndMuted)
    If silent
      If PcLastMs = 0 Or t0 - PcLastMs > 100 : PcLastMs = t0 - 17 : EndIf   ; starting, or after a pause
      PcOwedMs + (t0 - PcLastMs) : PcLastMs = t0
      If PcOwedMs < 16.688 : ProcedureReturn : EndIf
    EndIf
    While Running And n < 3
      For ln = 1 To #PC86_LINES
        ran + PcRunLine()
        If BreakAt >= 0 And Cpu86GetIP() = BreakAt
          Running = 0 : Status$ = "Stopped at the breakpoint " + H4(Cpu86GetSeg(1)) + ":" + H4(BreakAt) + " (checked once a scanline)."
          Break
        EndIf
        If MachineExited
          Running = 0 : Status$ = "The program wrote " + Str(MachineExitCode) + " to port F4h (exit)." : Break
        EndIf
        If Halted And (Cpu86Flags() & $200) = 0
          Running = 0 : Status$ = "HLT with interrupts off at " + H4(Cpu86GetSeg(1)) + ":" + H4(Cpu86GetIP()) + "." : Break
        EndIf
      Next
      PcSoundFrame()
      n + 1
      If silent
        PcOwedMs - 16.688
        If PcOwedMs < 16.688 : Break : EndIf
      ElseIf PcSoundPending() >= 3
        Break
      EndIf
    Wend
    If silent And PcOwedMs > 50 : PcOwedMs = 0 : EndIf     ; too far behind: let it go
    RateWindowCount + ran
    Executed + ran
    ProcedureReturn
  EndIf
  While Running And ElapsedMilliseconds() - t0 < budgetMs
    If BreakAt >= 0
      For k = 1 To 20000
        ran + Cpu86Run(1)
        If Cpu86GetIP() = BreakAt
          Running = 0 : Status$ = "Stopped at the breakpoint " + H4(Cpu86GetSeg(1)) + ":" + H4(BreakAt) + "."
          Break
        EndIf
        If Halted : Break : EndIf
      Next
    Else
      ran + Cpu86Run(500000)
    EndIf
    If MachineExited
      Running = 0 : Status$ = "The program exited with code " + Str(MachineExitCode) + "."
    ElseIf Halted
      Running = 0 : Status$ = "HLT at " + H4(Cpu86GetSeg(1)) + ":" + H4(Cpu86GetIP()) + " (an interrupt would wake it)."
    EndIf
  Wend
  RateWindowCount + ran
  Executed + ran
EndProcedure

Procedure.s FlagString(f.i)
  Protected s.s, i.i, names.s = "O D I T S Z A P C", bits.s = "11 10 9 8 7 6 4 2 0", n.s
  For i = 1 To 9
    n = StringField(names, i, " ")
    If f & (1 << Val(StringField(bits, i, " ")))
      s + n + " "
    Else
      s + LCase(n) + " "
    EndIf
  Next
  ProcedureReturn s
EndProcedure

Procedure DrawLine(x.f, y.f, t.s, r.f = -1, g.f = 0, b.f = 0)
  If r < 0
    Neon_Text(*Neon_FontMono, x, y, t, Neon_C_TextR, Neon_C_TextG, Neon_C_TextB)
  Else
    Neon_Text(*Neon_FontMono, x, y, t, r, g, b)
  EndIf
EndProcedure

Procedure DrawCpuPanel(x.f, y.f, w.f, h.f)
  Protected lh.f = Neon_S(18), yy.f, f.i = Cpu86Flags(), xx.f = x + Neon_S(10)
  Neon_Panel(x, y, w, h, "8086", Neon_C_AccR, Neon_C_AccG, Neon_C_AccB)
  yy = y + Neon_S(34)
  DrawLine(xx, yy, "AX " + H4(R(0)) + "   BX " + H4(R(3))) : yy + lh
  DrawLine(xx, yy, "CX " + H4(R(1)) + "   DX " + H4(R(2))) : yy + lh
  DrawLine(xx, yy, "SP " + H4(R(4)) + "   BP " + H4(R(5))) : yy + lh
  DrawLine(xx, yy, "SI " + H4(R(6)) + "   DI " + H4(R(7))) : yy + lh * 1.4
  DrawLine(xx, yy, "CS " + H4(Cpu86GetSeg(1)) + "   IP " + H4(Cpu86GetIP())) : yy + lh
  DrawLine(xx, yy, "DS " + H4(Cpu86GetSeg(3)) + "   ES " + H4(Cpu86GetSeg(0))) : yy + lh
  DrawLine(xx, yy, "SS " + H4(Cpu86GetSeg(2))) : yy + lh * 1.4
  DrawLine(xx, yy, "FLAGS " + H4(f)) : yy + lh
  DrawLine(xx, yy, FlagString(f), Neon_C_AmbR, Neon_C_AmbG, Neon_C_AmbB) : yy + lh * 1.4
  If #CPU_TIMING
    DrawLine(xx, yy, "clocks    " + Str(Executed)) : yy + lh
  Else
    DrawLine(xx, yy, "executed  " + Str(Executed)) : yy + lh
  EndIf
  If MachineKind = 1
    DrawLine(xx, yy, "line " + Str(PcLineNo) + "  frame " + Str(PcFrames)) : yy + lh
    DrawLine(xx, yy, "PIC " + H2(PicImr) + "/" + H2(PicIsr) + "  PIT0 " + Str(PitReload(0))) : yy + lh
  EndIf
  DrawLine(xx, yy, "state     " + StateText()) : yy + lh * 1.4
  DrawLine(xx, yy, "stack (SS:SP)") : yy + lh
  Protected k.i, s.s
  For k = 0 To 5
    s = "  +" + Str(k * 2) + "  " + H4(MachinePeek(SegB(2) + ((R(4) + k * 2) & $FFFF)) | (MachinePeek(SegB(2) + ((R(4) + k * 2 + 1) & $FFFF)) << 8))
    DrawLine(xx, yy, s) : yy + lh
    If yy > y + h - lh : Break : EndIf
  Next
EndProcedure

Procedure DrawDisasm(x.f, y.f, w.f, h.f)
  Protected lh.f = Neon_S(18), rows.i, i.i, adr.i, n.i, t.s, yy.f, k.i, found.i, bytes.s, cs.i = Cpu86GetSeg(1), ip.i = Cpu86GetIP()
  Neon_Panel(x, y, w, h, "Disassembly  (click a line for a breakpoint)", Neon_C_VioR, Neon_C_VioG, Neon_C_VioB)
  rows = Int((h - Neon_S(40)) / lh)
  adr = DisTop
  For i = 0 To rows - 3
    If adr = ip : found = 1 : Break : EndIf
    Dis86(cs, adr, @n) : adr = (adr + n) & $FFFF
  Next
  If found = 0 : DisTop = ip : EndIf
  adr = DisTop
  yy = y + Neon_S(32)
  For i = 0 To rows - 1
    t = Dis86(cs, adr, @n)
    If adr = ip
      Neon_Box(x + Neon_S(4), yy - Neon_S(2), w - Neon_S(8), lh, Neon_C_AccR, Neon_C_AccG, Neon_C_AccB, 0.18)
    EndIf
    If adr = BreakAt
      Neon_Box(x + Neon_S(6), yy + Neon_S(3), Neon_S(8), Neon_S(8), Neon_C_RedR, Neon_C_RedG, Neon_C_RedB)
    EndIf
    If i = 2 : CtlSet("disassembly row", x, yy - Neon_S(2), w, lh) : DisRowAdr = adr : EndIf
    If Neon_MouseClicked And Neon_Hit(x, yy - Neon_S(2), w, lh)
      If BreakAt = adr : BreakAt = -1 : BreakText\s = "" : Else : BreakAt = adr : BreakText\s = H4(adr) : EndIf
    EndIf
    bytes = ""
    For k = 0 To n - 1
      If k < 6 : bytes + H2(MachinePeek(SegB(1) + ((adr + k) & $FFFF))) : EndIf
    Next
    DrawLine(x + Neon_S(20), yy, H4(cs) + ":" + H4(adr) + "  " + LSet(bytes, 13) + t, -1)
    yy + lh
    adr = (adr + n) & $FFFF
  Next
EndProcedure

; The CGA text screen at B800:0000, 80 x 25.
Procedure DrawScreen(x.f, y.f, w.f, h.f)
  Protected lh.f = Neon_S(16), r.i, c.i, s.s, ch.i, yy.f = y
  For r = 0 To 24
    s = ""
    For c = 0 To 79
      ch = MachinePeek($B8000 + (r * 80 + c) * 2)
      If ch < 32 Or ch > 126 : ch = 32 : EndIf
      s + Chr(ch)
    Next
    DrawLine(x, yy, s, Neon_C_GrnR, Neon_C_GrnG, Neon_C_GrnB)
    yy + lh
    If yy > y + h - lh : Break : EndIf
  Next
EndProcedure

; The PC machine's picture: 640 x 200, each line drawn twice (640 x 400).
Procedure DrawPcScreen(x.f, y.f, w.f, h.f)
  Protected sc.f, sw.f, sh.f
  If PcTexReady = 0 : ProcedureReturn : EndIf
  PcTextureUpload()
  sc = w / #PC_FW
  If (h - Neon_S(22)) / (#PC_FH * 2) < sc : sc = (h - Neon_S(22)) / (#PC_FH * 2) : EndIf
  sw = #PC_FW * sc : sh = #PC_FH * 2 * sc
  Neon_Box(x + (w - sw) / 2 - 2, y - 2, sw + 4, sh + 4, 0.15, 0.20, 0.30)
  DrawGLSprite(@PcSprite, x + (w - sw) / 2, y, 0.0, sc, 1.0, 1.0, 1.0, 1.0, #True, -1, -1, -1, -1, #True)
  If MachineKind = 1 And Running
    Neon_Text(*Neon_FontSmall, x, y + sh + Neon_S(6), "Keys go to the PC while this tab shows it.", Neon_C_DimR, Neon_C_DimG, Neon_C_DimB)
  EndIf
EndProcedure

; The Controls tab: controls.pbi's table, the same rows the keyboard code reads.
Global CtlTop.i
Procedure DrawControls(x.f, y.f, w.f, h.f)
  Protected lh.f = Neon_S(19), rows.i, n.i, i.i, yy.f, group.i = -1, kx.f = x + Neon_S(14), wx.f = x + Neon_S(200)
  n = ListSize(CtlRows()) + 4
  rows = Int((h - Neon_S(8)) / lh)
  If Neon_Hit(x, y, w, h) And Neon_Wheel : CtlTop - Neon_Wheel * 3 : EndIf
  Neon_ScrollBarV(104, x + w - Neon_S(14), y + Neon_S(4), Neon_S(12), h - Neon_S(8), n, rows, @CtlTop)
  If CtlTop > n - rows : CtlTop = n - rows : EndIf
  If CtlTop < 0 : CtlTop = 0 : EndIf
  yy = y + Neon_S(6) - CtlTop * lh
  ForEach CtlRows()
    If CtlRows()\group <> group
      group = CtlRows()\group
      If group <> #CTL_PC : yy + lh : EndIf
      If yy >= y And yy < y + h - lh
        If group = #CTL_PC
          Neon_Text(*Neon_FontBold, kx, yy, "The PC's keyboard - on the PC screen tab, or in full screen, while the PC runs", Neon_C_AccR, Neon_C_AccG, Neon_C_AccB)
        Else
          Neon_Text(*Neon_FontBold, kx, yy, "The window", Neon_C_AccR, Neon_C_AccG, Neon_C_AccB)
        EndIf
      EndIf
      yy + lh
    EndIf
    If yy >= y And yy < y + h - lh
      Neon_Text(*Neon_FontMono, kx, yy, CtlRows()\keys$, Neon_C_TextR, Neon_C_TextG, Neon_C_TextB)
      Neon_Text(*Neon_FontUI, wx, yy, CtlRows()\what$, Neon_C_DimR, Neon_C_DimG, Neon_C_DimB)
    EndIf
    yy + lh
  Next
EndProcedure

Procedure DrawMemory(x.f, y.f, w.f, h.f)
  Protected lh.f = Neon_S(18), rows.i, total.i = 65536, r.i, c.i, a.i, s.s, yy.f, base.i, txt.s, v.i
  Neon_Panel(x, y, w, h, "Memory", Neon_C_GrnR, Neon_C_GrnG, Neon_C_GrnB)
  MemTab = Neon_TabStrip(101, x + Neon_S(2), y + Neon_S(28), w - Neon_S(4), Neon_S(26), "DS:0000|SS:SP|ES:DI|Address|Screen B800|PC screen|Controls", MemTab)
  If MemTab = 6
    DrawControls(x, y + Neon_S(58), w, h - Neon_S(58))
    ProcedureReturn
  EndIf
  If MemTab = 5
    DrawPcScreen(x + Neon_S(6), y + Neon_S(60), w - Neon_S(12), h - Neon_S(64))
    ProcedureReturn
  EndIf
  If MemTab = 4
    DrawScreen(x + Neon_S(10), y + Neon_S(62), w - Neon_S(20), h - Neon_S(66))
    ProcedureReturn
  EndIf
  Select MemTab
    Case 0 : base = SegB(3)
    Case 1 : base = SegB(2) + (R(4) & $FFF0)
    Case 2 : base = SegB(0) + (R(7) & $FFF0)
    Default
      Neon_Text(*Neon_FontUI, x + Neon_S(10), y + Neon_S(64), "Linear (hex)", Neon_C_DimR, Neon_C_DimG, Neon_C_DimB)
      CtlSet("Address field", x + Neon_S(100), y + Neon_S(58), Neon_S(100), Neon_S(26))
      If Neon_TextInput(103, x + Neon_S(100), y + Neon_S(58), Neon_S(100), Neon_S(26), @AddrText, "e.g. B8000", @AddrCaret)
        MemBase = Val("$" + Trim(AddrText\s)) & $FFFF0
      EndIf
      base = MemBase
      y + Neon_S(30) : h - Neon_S(30)
  EndSelect
  rows = Int((h - Neon_S(70)) / lh)
  If Neon_Hit(x, y, w, h) And Neon_Wheel : MemTop - Neon_Wheel * 3 : EndIf
  Neon_ScrollBarV(102, x + w - Neon_S(14), y + Neon_S(58), Neon_S(12), h - Neon_S(62), total, rows, @MemTop)
  If MemTop > total - rows : MemTop = total - rows : EndIf
  If MemTop < 0 : MemTop = 0 : EndIf
  yy = y + Neon_S(62)
  For r = MemTop To MemTop + rows - 1
    a = (base + r * 16) & $FFFFF
    s = RSet(Hex(a), 5, "0") + "  " : txt = ""
    For c = 0 To 15
      v = MachinePeek(a + c)
      s + H2(v) + " "
      If v >= 32 And v < 127 : txt + Chr(v) : Else : txt + "." : EndIf
    Next
    DrawLine(x + Neon_S(10), yy, s + " " + txt)
    yy + lh
  Next
EndProcedure

Procedure DrawLog(x.f, y.f, w.f, h.f)
  Protected lh.f = Neon_S(17), rows.i, n.i, i.i, t.s, yy.f, line.s
  Neon_Panel(x, y, w, h, "Output", Neon_C_AmbR, Neon_C_AmbG, Neon_C_AmbB)
  LogTab = Neon_TabStrip(201, x + Neon_S(2), y + Neon_S(28), w - Neon_S(4), Neon_S(26), "Console (INT 21h, port E9h)|Test results", LogTab)
  If LogTab = 0 : t = MachineConsole$ : Else : t = TestLog$ : EndIf
  If t = "" : t = "(nothing yet)" : EndIf
  n = CountString(t, #LF$) + 1
  rows = Int((h - Neon_S(66)) / lh)
  If Neon_Hit(x, y, w, h) And Neon_Wheel : LogTop - Neon_Wheel * 3 : EndIf
  CtlSet("output scroll bar", x + w - Neon_S(14), y + Neon_S(58), Neon_S(12), h - Neon_S(62))
  Neon_ScrollBarV(202, x + w - Neon_S(14), y + Neon_S(58), Neon_S(12), h - Neon_S(62), n, rows, @LogTop)
  If LogTop > n - rows : LogTop = n - rows : EndIf
  If LogTop < 0 : LogTop = 0 : EndIf
  yy = y + Neon_S(60)
  For i = LogTop To LogTop + rows - 1
    If i >= n : Break : EndIf
    line = StringField(t, i + 1, #LF$)
    If FindString(line, "FAIL") Or Mid(line, 1, 2) = "F "
      DrawLine(x + Neon_S(10), yy, line, Neon_C_RedR, Neon_C_RedG, Neon_C_RedB)
    ElseIf FindString(line, "PASS") Or FindString(line, " 0 failed")
      DrawLine(x + Neon_S(10), yy, line, Neon_C_GrnR, Neon_C_GrnG, Neon_C_GrnB)
    Else
      DrawLine(x + Neon_S(10), yy, line)
    EndIf
    yy + lh
  Next
EndProcedure

Procedure RunTestsInWindow()
  Protected *save, saveLen.i, name.s
  Running = 0
  Status$ = "Running the test suites..."
  TestsFailed = RunAllTests(DefaultStream$)
  TestsRun = 1
  LogTab = 1 : LogTop = 0
  If TestsFailed = 0
    Status$ = "All test suites passed on the desktop core (the same test code and corpus as the board)."
  Else
    Status$ = Str(TestsFailed) + " test suite(s) FAILED - see Test results."
  EndIf
EndProcedure

Procedure LoadExample(name.s)
  Running = 0
  If LoadProgram(GetPathPart(ProgramFilename()) + "examples\" + name)
    Status$ = "Loaded " + name + "." : DisTop = $100 : Executed = 0 : LogTab = 0
  Else
    Status$ = "Could not read examples\" + name
  EndIf
EndProcedure

Procedure DrawToolbar(w.f)
  Protected x.f = Neon_S(10), y.f = Neon_S(8), bh.f = Neon_S(30), f.s, label.s, r.f, k.i
  Neon_Box(0, 0, w, Neon_S(46), Neon_C_HeadR, Neon_C_HeadG, Neon_C_HeadB)
  If Btn("Open...", x, y, Neon_S(86), bh, "Open...")
    f = OpenFileRequester("Load an 8086 program", "", "DOS programs (*.com)|*.com|Binary (*.bin)|*.bin|All files (*.*)|*.*", 0)
    If f <> ""
      Running = 0
      If LoadProgram(f) : Status$ = "Loaded " + MachineName$ + " (" + Str(MachineLoadBytes) + " bytes)" + LoadText() : DisTop = $100 : Executed = 0 : LogTab = 0
      Else : Status$ = "Could not read " + f : EndIf
    EndIf
  EndIf
  x + Neon_S(94)
  If Btn("Hello", x, y, Neon_S(70), bh, "Hello")
    LoadExample("hello.com")
  EndIf
  x + Neon_S(78)
  If Btn("Sieve", x, y, Neon_S(70), bh, "Sieve")
    LoadExample("sieve.com")
  EndIf
  x + Neon_S(78)
  If MachineKind = 1 : label = "PC machine" : Else : label = "DOS machine" : EndIf
  If Btn("Machine", x, y, Neon_S(110), bh, label, Bool(MachineKind = 1), Bool(#CPU_TIMING = 1))
    Running = 0
    MachineKind = 1 - MachineKind
    ResetProgram() : MachineConsole$ = "" : Executed = 0
    If MachineKind = 1
      MemTab = 5 : Status$ = "The PC machine: 640 KB, CGA at B800, 8253, 8259, keyboard, speaker; programs load at 0050:0100."
    Else
      MemTab = 0 : Status$ = "The DOS-style machine: programs load at 1000:0100 with INT 21h services."
    EndIf
  EndIf
  x + Neon_S(118)
  If Btn("Reset", x, y, Neon_S(70), bh, "Reset")
    Running = 0 : ResetProgram() : MachineConsole$ = "" : Executed = 0 : Status$ = "Reset."
  EndIf
  x + Neon_S(78)
  label = "Run"
  If Running : label = "Stop" : EndIf
  If Btn("Run", x, y, Neon_S(70), bh, label, Running)
    Running = Bool(Running = 0)
    If Running
      If MachineExited Or Halted : Running = 0 : Status$ = "Reset first." : EndIf
      If Running And Cpu86GetIP() = BreakAt : StepOne() : EndIf
      If Running : Status$ = "Running." : EndIf
    Else
      Status$ = "Stopped at " + H4(Cpu86GetSeg(1)) + ":" + H4(Cpu86GetIP()) + "."
    EndIf
  EndIf
  x + Neon_S(78)
  If Btn("Step", x, y, Neon_S(70), bh, "Step", #False, Bool(Running = 0))
    StepOne() : Status$ = "Stepped to " + H4(Cpu86GetSeg(1)) + ":" + H4(Cpu86GetIP()) + "."
  EndIf
  x + Neon_S(78)
  If Btn("Step 100", x, y, Neon_S(90), bh, "Step 100", #False, Bool(Running = 0))
    For k = 1 To 100
      StepOne()
      If Cpu86GetIP() = BreakAt Or Halted Or MachineExited : Break : EndIf
    Next
    Status$ = "Stepped to " + H4(Cpu86GetSeg(1)) + ":" + H4(Cpu86GetIP()) + "."
  EndIf
  x + Neon_S(98)
  Neon_Text(*Neon_FontUI, x, y + Neon_S(6), "Break at IP", Neon_C_DimR, Neon_C_DimG, Neon_C_DimB)
  x + Neon_S(78)
  CtlSet("Break at field", x, y, Neon_S(70), bh)
  If Neon_TextInput(301, x, y, Neon_S(70), bh, @BreakText, "hex", @BreakCaret)
    If Trim(BreakText\s) = ""
      BreakAt = -1
    Else
      BreakAt = Val("$" + Trim(BreakText\s)) & $FFFF
    EndIf
  EndIf
  x + Neon_S(78)
  If Btn("Run tests", x, y, Neon_S(110), bh, "Run tests", Bool(TestsRun And TestsFailed = 0))
    RunTestsInWindow()
  EndIf
  x + Neon_S(118)
  If Btn("Full screen", x, y, Neon_S(120), bh, "Full screen  F11", FullScreen, Bool(MachineKind = 1))
    WindowAction(#CTL_FULLSCREEN)
  EndIf
  r = RateShown / 1000000.0
  label = StrF(r, 1) + " M instructions/s"
  If #CPU_TIMING : label = StrF(r, 2) + " MHz (" + StrF(r / 4.772727, 1) + "x a 4.77 MHz 8086)" : EndIf
  Neon_TextRight(*Neon_FontUI, w - Neon_S(12), y + Neon_S(6), label,
                 Neon_C_AccR, Neon_C_AccG, Neon_C_AccB)
EndProcedure

; The window's own back buffer, read before the flip, written as a PNG.
Procedure SaveShot(pw.i, ph.i)
  Protected *px = AllocateMemory(pw * ph * 4), img.i, x.i, y.i, c.l
  glReadPixels_(0, 0, pw, ph, #GL_RGBA, #GL_UNSIGNED_BYTE, *px)
  img = CreateImage(#PB_Any, pw, ph, 24)
  If img And StartDrawing(ImageOutput(img))
    For y = 0 To ph - 1
      For x = 0 To pw - 1
        c = PeekL(*px + ((ph - 1 - y) * pw + x) * 4)
        Plot(x, y, RGB(c & 255, (c >> 8) & 255, (c >> 16) & 255))
      Next
    Next
    StopDrawing()
    SaveImage(img, ShotPath$, #PB_ImagePlugin_PNG)
  EndIf
  FreeMemory(*px)
  ShotPath$ = ""
  ShotFrames = -1
EndProcedure

; ---------------------------------------------------------------- full screen
; A borderless window over the window's own monitor (the display mode does not change),
; showing only the PC's screen: the CGA picture at its 4:3 shape with its border, as
; large as fits, centred on black. The pointer hides after two idle seconds. F11 or the
; Full screen button toggles it, Esc leaves (controls.pbi); the window's placement and
; style are saved on entering and put back exactly on leaving. The PC machine only.
Global FsStyle.i, FsPlacement.WINDOWPLACEMENT, FsCursorHidden.i, FsMouseX.i, FsMouseY.i, FsMouseMs.q
Global FsViewX.f, FsViewY.f, FsViewW.f, FsViewH.f

Procedure FsShowCursor(show.i)
  If show And FsCursorHidden : ShowCursor_(#True) : FsCursorHidden = 0 : EndIf
  If show = 0 And FsCursorHidden = 0 : ShowCursor_(#False) : FsCursorHidden = 1 : EndIf
EndProcedure

Procedure EnterFullScreen()
  Protected hwnd.i, mi.MONITORINFO
  If FullScreen Or MachineKind <> 1 : ProcedureReturn : EndIf
  hwnd = WindowID(Win)
  FsPlacement\length = SizeOf(WINDOWPLACEMENT) : GetWindowPlacement_(hwnd, @FsPlacement)
  FsStyle = GetWindowLongPtr_(hwnd, #GWL_STYLE)
  mi\cbSize = SizeOf(MONITORINFO) : GetMonitorInfo_(MonitorFromWindow_(hwnd, 2), @mi)   ; 2: the nearest monitor
  SetWindowLongPtr_(hwnd, #GWL_STYLE, FsStyle & ~(#WS_CAPTION | #WS_THICKFRAME | #WS_MINIMIZEBOX | #WS_MAXIMIZEBOX | #WS_SYSMENU))
  SetWindowPos_(hwnd, #HWND_TOP, mi\rcMonitor\left, mi\rcMonitor\top, mi\rcMonitor\right - mi\rcMonitor\left, mi\rcMonitor\bottom - mi\rcMonitor\top, #SWP_FRAMECHANGED | #SWP_NOOWNERZORDER | #SWP_SHOWWINDOW)
  FullScreen = 1 : FsMouseMs = ElapsedMilliseconds()
  Neon_FocusID = 0                          ; the keys go to the PC
  SetActiveGadget(Gl)
EndProcedure

Procedure LeaveFullScreen()
  Protected hwnd.i
  If FullScreen = 0 : ProcedureReturn : EndIf
  hwnd = WindowID(Win)
  SetWindowLongPtr_(hwnd, #GWL_STYLE, FsStyle)
  SetWindowPlacement_(hwnd, @FsPlacement)
  SetWindowPos_(hwnd, 0, 0, 0, 0, 0, #SWP_FRAMECHANGED | #SWP_NOMOVE | #SWP_NOSIZE | #SWP_NOZORDER | #SWP_NOOWNERZORDER)
  FullScreen = 0 : FsShowCursor(1)
  SetActiveGadget(Gl)
EndProcedure

Procedure WindowAction(action.i)
  Select action
    Case #CTL_FULLSCREEN : If FullScreen : LeaveFullScreen() : Else : EnterFullScreen() : EndIf
    Case #CTL_LEAVEFULL : LeaveFullScreen()
  EndSelect
EndProcedure

; Keys reach the PC on the PC screen tab, or in full screen, while it runs.
Procedure.i PcKeysOn()
  ProcedureReturn Bool(MachineKind = 1 And Running And (MemTab = 5 Or FullScreen))
EndProcedure

; The PC's screen alone: the texture (704 x 464, the 640 x 200 picture with its border,
; lines doubled) drawn at the picture's 4:3 shape: 704 / 640 of the width and 232 / 200
; of the height of a 4:3 screen.
Procedure DrawPcFull(pw.f, ph.f)
  Protected a.f, vw.f, vh.f, sc.f, keepH.f
  Neon_Box(0, 0, pw, ph, 0.0, 0.0, 0.0)
  If PcTexReady = 0 : ProcedureReturn : EndIf
  PcTextureUpload()
  a = (4.0 / 3.0) * (#PC_FW * 1.0 / #PC_W) / (#PC_FH * 1.0 / #PC_H)
  vh = ph : vw = vh * a
  If vw > pw : vw = pw : vh = vw / a : EndIf
  FsViewW = vw : FsViewH = vh : FsViewX = (pw - vw) / 2 : FsViewY = (ph - vh) / 2
  sc = vw / #PC_FW
  keepH = PcSprite\Height
  PcSprite\Height = vh / sc
  DrawGLSprite(@PcSprite, FsViewX, FsViewY, 0.0, sc, 1.0, 1.0, 1.0, 1.0, #True, -1, -1, -1, -1, #True)
  PcSprite\Height = keepH
EndProcedure

; ---------------------------------------------------------------- --fullscreen-test
; Full screen by its own keys, no real pointer: F11 posted to the window's GL gadget, Esc
; to the window (the engine's Esc shortcut catches it there). Checked: the window covers
; its monitor, the canvas is the monitor, the view has the picture's 4:3 shape and is
; centred, Esc leaves, the windowed rectangle and style come back. Writes the log, ends.
Global FsTestOn.i, FsTestFile$, FsTestShot$, FsTestStep.i, FsTestWait.i, FsTestFails.i, FsTestLog$, FsTestDone.i
Global FsTestRect.RECT, FsTestStyle.i

Procedure FsTestCheck(ok.i, what$)
  If ok = 0 : FsTestFails + 1 : FsTestLog$ + "FAIL " : Else : FsTestLog$ + "ok   " : EndIf
  FsTestLog$ + what$ + #LF$
EndProcedure

Procedure FsTestTick(pw.i, ph.i)
  Protected r.RECT, mi.MONITORINFO, hwnd.i = WindowID(Win), f.i, aspect.f, want.f
  FsTestWait + 1 : If FsTestWait < 40 : ProcedureReturn : EndIf
  FsTestWait = 0 : FsTestStep + 1
  Select FsTestStep
    Case 1
      GetWindowRect_(hwnd, @FsTestRect) : FsTestStyle = GetWindowLongPtr_(hwnd, #GWL_STYLE)
      FsTestLog$ + "windowed: " + Str(FsTestRect\left) + "," + Str(FsTestRect\top) + " " + Str(FsTestRect\right - FsTestRect\left) + "x" + Str(FsTestRect\bottom - FsTestRect\top) + ", scale " + StrF(Neon_UIScale, 2) + #LF$
      PostMessage_(hwnd, #WM_KEYDOWN, #VK_ESCAPE, 0) : PostMessage_(hwnd, #WM_KEYUP, #VK_ESCAPE, 0)   ; windowed: the PC's Esc
      PostMessage_(GadgetID(Gl), #WM_KEYDOWN, #VK_F11, 0) : PostMessage_(GadgetID(Gl), #WM_KEYUP, #VK_F11, 0)
    Case 2
      GetWindowRect_(hwnd, @r) : mi\cbSize = SizeOf(MONITORINFO) : GetMonitorInfo_(MonitorFromWindow_(hwnd, 2), @mi)
      FsTestCheck(FullScreen, "F11 entered full screen")
      FsTestCheck(Bool(r\left = mi\rcMonitor\left And r\top = mi\rcMonitor\top And r\right = mi\rcMonitor\right And r\bottom = mi\rcMonitor\bottom), "the window covers its monitor " + Str(mi\rcMonitor\right - mi\rcMonitor\left) + "x" + Str(mi\rcMonitor\bottom - mi\rcMonitor\top))
      FsTestCheck(Bool(pw = mi\rcMonitor\right - mi\rcMonitor\left And ph = mi\rcMonitor\bottom - mi\rcMonitor\top), "the canvas is the whole monitor (" + Str(pw) + "x" + Str(ph) + ")")
      want = (4.0 / 3.0) * (#PC_FW * 1.0 / #PC_W) / (#PC_FH * 1.0 / #PC_H)
      aspect = FsViewW / FsViewH
      FsTestCheck(Bool(Abs(aspect - want) < 0.002 And FsViewW <= pw And FsViewH <= ph), "the view " + StrF(FsViewW, 1) + "x" + StrF(FsViewH, 1) + " has the 4:3 picture's shape with its border, " + StrF(want, 4) + " (" + StrF(aspect, 4) + "), and fits")
      FsTestCheck(Bool(Abs(FsViewX * 2 + FsViewW - pw) <= 1 And Abs(FsViewY * 2 + FsViewH - ph) <= 1), "the view is centred at " + StrF(FsViewX, 1) + "," + StrF(FsViewY, 1))
      FsTestCheck(Bool(Running And MachineKind = 1), "the PC is still running")
      If FsTestShot$ <> "" : ShotPath$ = FsTestShot$ : SaveShot(pw, ph) : ShotFrames = 0 : EndIf   ; SaveShot ends a --screenshot run; this one goes on
      PostMessage_(GadgetID(Gl), #WM_KEYDOWN, #VK_F12, 0) : PostMessage_(GadgetID(Gl), #WM_KEYUP, #VK_F12, 0)   ; full screen: F12 is the PC's Esc
      PostMessage_(hwnd, #WM_KEYDOWN, #VK_ESCAPE, 0) : PostMessage_(hwnd, #WM_KEYUP, #VK_ESCAPE, 0)
    Case 3
      GetWindowRect_(hwnd, @r)
      FsTestCheck(Bool(FullScreen = 0), "Esc left full screen")
      FsTestCheck(Bool(r\left = FsTestRect\left And r\top = FsTestRect\top And r\right = FsTestRect\right And r\bottom = FsTestRect\bottom), "the windowed rectangle came back: " + Str(r\left) + "," + Str(r\top) + " " + Str(r\right - r\left) + "x" + Str(r\bottom - r\top))
      FsTestCheck(Bool(GetWindowLongPtr_(hwnd, #GWL_STYLE) = FsTestStyle), "the window's frame and style came back")
      If LCase(MachineName$) = "keytest.com"     ; it prints every scan code the PC gets
        FsTestCheck(Bool(CountString(MachineConsole$, "01 81 ") = 2), "the PC got Esc twice (Esc in the window, F12 in full screen), and not the Esc that left: " + Trim(MachineConsole$))
      EndIf
      FsTestLog$ + "fullscreen-test: " + Str(FsTestFails) + " failures" + #LF$
      f = CreateFile(#PB_Any, FsTestFile$) : If f : WriteString(f, FsTestLog$) : CloseFile(f) : EndIf
      FsTestDone = 1
  EndSelect
EndProcedure

; ---------------------------------------------------------------- --pointer-test
; The mouse and the controls at the desktop's scale without the real pointer (it
; is shared): the chrome is driven with synthetic positions in the units
; WindowMouseX/Y give a DPI-aware window, physical pixels (GlUIChrome.pbi 5a).
; For every control four points: just inside its top-left and bottom-right
; corners (the press must land), just right of it and just below it (it must
; not; right of a tab is the next tab). Every frame Neon_MX/Neon_MY must read the
; point back unbent. Controls at the top (toolbar, tabs) and at the bottom (the
; output tabs and scroll bar) are both covered.
Global SynthFile$, SynthX.f, SynthY.f, SynthDown.i, SynthCase.i, SynthPoint.i, SynthFrame.i, SynthDone.i
Global SynthFails.i, SynthPoints.i, SynthLog$, SynthWorst.f, SynthSave.i, SynthSaveStr$, SynthCanvasW.i, SynthCanvasH.i
Global Dim SynthName$(40), Dim SynthMemTab.i(40), SynthCount.i

Procedure SynthAdd(name$, memtab.i = -1)
  SynthName$(SynthCount) = name$ : SynthMemTab(SynthCount) = memtab : SynthCount + 1
EndProcedure

Procedure SynthInit()
  Protected i.i
  ForEach Ctl() : Next
  SynthAdd("Open...") : SynthAdd("Hello") : SynthAdd("Sieve") : SynthAdd("Machine") : SynthAdd("Reset")
  SynthAdd("Run") : SynthAdd("Step") : SynthAdd("Step 100") : SynthAdd("Break at field") : SynthAdd("Run tests") : SynthAdd("Full screen")
  For i = 0 To 6 : SynthAdd("memory tab " + Str(i)) : Next
  SynthAdd("Address field", 3)
  SynthAdd("disassembly row")
  For i = 0 To 1 : SynthAdd("output tab " + Str(i)) : Next
  SynthAdd("output scroll bar")
EndProcedure

; The control's rectangle as last drawn; 0 when it was not.
Procedure.i SynthRect(name$, *r.CtlRect)
  Protected *row.Neon_TabRowLayout, i.i, id$
  If Left(name$, 11) = "memory tab " : id$ = "101" : i = Val(Mid(name$, 12)) : EndIf
  If Left(name$, 11) = "output tab " : id$ = "201" : i = Val(Mid(name$, 12)) : EndIf
  If id$ <> ""
    If FindMapElement(Neon_TabLayout(), id$) = 0 : ProcedureReturn 0 : EndIf
    *row = @Neon_TabLayout()
    If i >= *row\Count : ProcedureReturn 0 : EndIf
    ; the row's last pixel belongs to the strip's underline, not to a tab
    *r\x = *row\X(i) : *r\w = *row\W(i) : *r\y = *row\Y : *r\h = *row\H - 1
    ProcedureReturn 1
  EndIf
  If FindMapElement(Ctl(), name$) = 0 : ProcedureReturn 0 : EndIf
  *r\x = Ctl()\x : *r\y = Ctl()\y : *r\w = Ctl()\w : *r\h = Ctl()\h
  ProcedureReturn 1
EndProcedure

Procedure SynthFinish()
  Protected f.i
  SynthLog$ + "pointer-test: " + Str(SynthPoints) + " points on " + Str(SynthCount) + " controls, " + Str(SynthFails) +
              " failures, scale " + StrF(Neon_UIScale, 2) + ", canvas " + Str(SynthCanvasW) + "x" + Str(SynthCanvasH) +
              ", worst pointer read-back error " + StrF(SynthWorst, 2) + " px" + #LF$
  f = CreateFile(#PB_Any, SynthFile$)
  If f : WriteString(f, SynthLog$) : CloseFile(f) : EndIf
  SynthDone = 1
EndProcedure

; One step of the test, after each frame is drawn.
Procedure SynthStep()
  Protected r.CtlRect, name$, inside.i, hit.i, expect$, got$, i.i, k.i
  If SynthCase >= SynthCount : SynthFinish() : ProcedureReturn : EndIf
  name$ = SynthName$(SynthCase)
  If Abs(Neon_MX - SynthX) > SynthWorst : SynthWorst = Abs(Neon_MX - SynthX) : EndIf
  If Abs(Neon_MY - SynthY) > SynthWorst : SynthWorst = Abs(Neon_MY - SynthY) : EndIf
  SynthFrame + 1
  Select SynthFrame
    Case 1                                       ; the state that shows the control
      If SynthMemTab(SynthCase) >= 0 : MemTab = SynthMemTab(SynthCase) : EndIf
      If name$ = "Full screen" : SynthSave = MachineKind : MachineKind = 1 : EndIf   ; it is the PC machine's
      If name$ = "output scroll bar"            ; enough lines to scroll, the view mid-way
        SynthSaveStr$ = MachineConsole$ : MachineConsole$ = ""
        For k = 1 To 300 : MachineConsole$ + "line " + Str(k) + #LF$ : Next
        LogTab = 0 : LogTop = 100
      EndIf
      SynthX = 1 : SynthY = 1 : SynthDown = 0
    Case 2                                       ; drawn: go to the point
      If SynthRect(name$, @r) = 0
        SynthLog$ + "FAIL " + name$ + ": not drawn" + #LF$ : SynthFails + 1
        SynthFrame = 0 : SynthPoint = 0 : SynthCase + 1 : ProcedureReturn
      EndIf
      Select SynthPoint
        Case 0 : SynthX = r\x + 2 : SynthY = r\y + 2
        Case 1 : SynthX = r\x + r\w - 2 : SynthY = r\y + r\h - 2
        Case 2 : SynthX = r\x + r\w + 2 : SynthY = r\y + r\h - 2
        Case 3 : SynthX = r\x + r\w - 2 : SynthY = r\y + r\h + 2
      EndSelect
      SynthClicked$ = "" : Neon_FocusID = 0
      If Left(name$, 11) = "memory tab " : SynthSave = MemTab : MemTab = 99 : EndIf   ; none selected
      If Left(name$, 11) = "output tab " : SynthSave = LogTab : LogTab = 99 : EndIf
      If name$ = "disassembly row" : SynthSave = BreakAt : BreakAt = -1 : EndIf
      If name$ = "output scroll bar" : LogTop = 100 : EndIf
    Case 3 : SynthDown = 1
    Case 4 : SynthDown = 0
    Case 5                                       ; what the press did
      inside = Bool(SynthPoint <= 1)
      If Left(name$, 11) = "memory tab " Or Left(name$, 11) = "output tab "
        i = Val(Mid(name$, 12))
        k = 6 : If Left(name$, 11) = "output tab " : k = 1 : EndIf
        If inside : expect$ = Left(name$, 11) + Str(i) : ElseIf SynthPoint = 2 And i < k : expect$ = Left(name$, 11) + Str(i + 1) : EndIf
        If Left(name$, 11) = "memory tab "
          If MemTab >= 0 And MemTab <= 6 : got$ = "memory tab " + Str(MemTab) : EndIf
          MemTab = SynthSave
        Else
          If LogTab >= 0 And LogTab <= 1 : got$ = "output tab " + Str(LogTab) : EndIf
          LogTab = SynthSave
        EndIf
      ElseIf name$ = "Break at field" Or name$ = "Address field"
        If inside : expect$ = name$ : EndIf
        If (name$ = "Break at field" And Neon_FocusID = 301) Or (name$ = "Address field" And Neon_FocusID = 103) : got$ = name$ : EndIf
      ElseIf name$ = "disassembly row"
        If inside : expect$ = name$ : EndIf
        If BreakAt = DisRowAdr : got$ = name$ : EndIf
        BreakAt = SynthSave : If BreakAt < 0 : BreakText\s = "" : EndIf
      ElseIf name$ = "output scroll bar"
        If inside : expect$ = name$ : EndIf
        If LogTop <> 100 : got$ = name$ : EndIf
      Else
        If inside : expect$ = name$ : EndIf
        got$ = SynthClicked$
      EndIf
      SynthPoints + 1
      hit = Bool(got$ = expect$)
      If hit = 0 : SynthFails + 1 : EndIf
      SynthLog$ + StringField("FAIL|ok  ", hit + 1, "|") + " " + LSet(name$, 18) + " " + StringField("top-left in|bottom-right in|right of it|below it", SynthPoint + 1, "|") +
                  " (" + StrF(SynthX, 1) + ", " + StrF(SynthY, 1) + "): expected '" + expect$ + "', got '" + got$ + "'" + #LF$
      Neon_FocusID = 0
      SynthFrame = 0 : SynthPoint + 1
      If SynthPoint > 3
        SynthPoint = 0
        If SynthMemTab(SynthCase) >= 0 : MemTab = 0 : EndIf
        If name$ = "output scroll bar" : MachineConsole$ = SynthSaveStr$ : LogTop = 0 : EndIf
        If name$ = "Full screen" : MachineKind = SynthSave : EndIf
        SynthCase + 1
      EndIf
  EndSelect
EndProcedure

; The chrome's scale and its four fonts (logical pixel sizes * s, snapped). Built
; again whenever s changes: the window moved to a monitor with another scale.
Global FontScale.f
Procedure ScaleFonts(s.f)
  If s = FontScale : ProcedureReturn : EndIf
  FontScale = s
  Neon_UIScale = s
  *Neon_FontUI = Neon_CreateFontPx("Segoe UI", Round(14 * s, #PB_Round_Nearest))
  *Neon_FontSmall = Neon_CreateFontPx("Segoe UI", Round(12 * s, #PB_Round_Nearest))
  *Neon_FontBold = Neon_CreateFontPx("Segoe UI", Round(15 * s, #PB_Round_Nearest), #PB_Font_Bold)
  *Neon_FontMono = Neon_CreateFontPx("Consolas", Round(14 * s, #PB_Round_Nearest))
  GLFontSetSnapToPixel(*Neon_FontUI, #True)
  GLFontSetSnapToPixel(*Neon_FontSmall, #True)
  GLFontSetSnapToPixel(*Neon_FontBold, #True)
  GLFontSetSnapToPixel(*Neon_FontMono, #True)
EndProcedure

Procedure Frame()
  Protected r.RECT, pw.i, ph.i, mx.i, my.i, down.b, w.f, h.f, colW.f, top.f, logH.f, now.q, midH.f, lw.i, lh.i
  SetGadgetAttribute(Gl, #PB_OpenGL_SetContext, #True)
  GetClientRect_(WindowID(Win), @r)
  pw = r\right - r\left : ph = r\bottom - r\top
  If pw < 1 Or ph < 1 : ProcedureReturn : EndIf
  If GadgetWidth(Gl) <> WindowWidth(Win) Or GadgetHeight(Gl) <> WindowHeight(Win)
    ResizeGadget(Gl, 0, 0, WindowWidth(Win), WindowHeight(Win))
  EndIf
  ; The engine's hosting rules for Windows, as measured (GlUIChrome.pbi section 5a):
  ; the canvas and viewport are the PHYSICAL client, Util_Win* the LOGICAL one,
  ; s = physical / logical, and the mouse goes in as WindowMouseX/Y give it
  ; (already physical in a DPI-aware window - scaling it again puts clicks off).
  lw = WindowWidth(Win, #PB_Window_InnerCoordinate) : lh = WindowHeight(Win, #PB_Window_InnerCoordinate)
  If lw < 1 Or lh < 1 : ProcedureReturn : EndIf
  ScaleFonts(Round(pw * 100.0 / lw, #PB_Round_Nearest) / 100.0)
  Util_BaseWidth = pw : Util_BaseHeight = ph
  Util_WinWidth = lw : Util_WinHeight = lh
  GL_ViewportX = 0 : GL_ViewportY = 0 : GL_ViewportW = pw : GL_ViewportH = ph
  If SynthOn
    SynthCanvasW = pw : SynthCanvasH = ph
    Neon_ChromeBeginFrame(SynthX, SynthY, SynthDown, 0, 0, 0, 1.0 / 60.0)   ; --pointer-test: the real pointer is not read
  Else
    mx = WindowMouseX(Win) : my = WindowMouseY(Win)
    If FullScreen                            ; the pointer hides after two idle seconds, shows on a move
      If mx <> FsMouseX Or my <> FsMouseY : FsMouseX = mx : FsMouseY = my : FsMouseMs = ElapsedMilliseconds() : FsShowCursor(1) : EndIf
      If ElapsedMilliseconds() - FsMouseMs > 2000 : FsShowCursor(0) : EndIf
    EndIf
    down = Bool(GetActiveWindow() = Win And (GetAsyncKeyState_(#VK_LBUTTON) & $8000))
    Neon_ChromeBeginFrame(mx, my, down, Wheel, KeyCode, KeyChar, 1.0 / 60.0)
  EndIf
  Wheel = 0 : KeyCode = 0 : KeyChar = 0
  glBindFramebuffer(#GL_FRAMEBUFFER, 0)
  glDisable_(#GL_SCISSOR_TEST)
  glViewport_(0, 0, pw, ph)
  glClearColor_(Neon_C_BgR, Neon_C_BgG, Neon_C_BgB, 1.0)
  glClear_(#GL_COLOR_BUFFER_BIT)

  If Running : RunFor(14) : EndIf
  now = ElapsedMilliseconds()
  If now - RateWindowStart >= 500
    RateShown = RateWindowCount * 1000.0 / (now - RateWindowStart)
    RateWindowCount = 0 : RateWindowStart = now
  EndIf

  If FullScreen
    DrawPcFull(pw, ph)
    Neon_ChromeEndFrame()
    If FsTestOn : FsTestTick(pw, ph) : EndIf
    SetGadgetAttribute(Gl, #PB_OpenGL_FlipBuffers, #True)
    ProcedureReturn
  EndIf
  w = pw : h = ph
  top = Neon_S(52)
  logH = Neon_S(230)
  colW = Neon_S(260)
  midH = h - top - logH - Neon_S(40)
  DrawToolbar(w)
  DrawCpuPanel(Neon_S(8), top, colW, midH)
  DrawDisasm(colW + Neon_S(16), top, Neon_S(520), midH)
  DrawMemory(colW + Neon_S(544), top, w - colW - Neon_S(552), midH)
  DrawLog(Neon_S(8), h - logH - Neon_S(32), w - Neon_S(16), logH)
  Neon_Box(0, h - Neon_S(26), w, Neon_S(26), Neon_C_HeadR, Neon_C_HeadG, Neon_C_HeadB)
  Neon_Text(*Neon_FontSmall, Neon_S(10), h - Neon_S(21), "Program: " + MachineName$ + "     " + Status$, Neon_C_DimR, Neon_C_DimG, Neon_C_DimB)
  Neon_ChromeEndFrame()
  If SynthOn : SynthStep() : EndIf
  If FsTestOn : FsTestTick(pw, ph) : EndIf
  If ShotPath$ <> ""
    ShotFrames + 1
    If ShotFrames = 120
      SaveShot(pw, ph)
    EndIf
  EndIf
  SetGadgetAttribute(Gl, #PB_OpenGL_FlipBuffers, #True)
EndProcedure

Procedure.f DisplayScale()
  Protected lib.i, fn.i, dpi.i
  lib = OpenLibrary(#PB_Any, "user32.dll")
  If lib
    fn = GetFunction(lib, "GetDpiForWindow")
    If fn And Win : dpi = CallFunctionFast(fn, WindowID(Win)) : EndIf
    CloseLibrary(lib)
  EndIf
  If dpi <= 0 : ProcedureReturn 1.0 : EndIf
  ProcedureReturn dpi / 96.0
EndProcedure

Procedure WindowMain()
  Protected lib.i, fn.i, ev.i, s.f, w.i = 1500, h.i = 920, quit.i, et.i, sysdpi.i, sc.f = 1.0
  Protected wa.RECT, k.i
  lib = OpenLibrary(#PB_Any, "user32.dll")
  If lib
    fn = GetFunction(lib, "SetProcessDpiAwarenessContext")
    If fn : CallFunctionFast(fn, -4) : EndIf
    fn = GetFunction(lib, "GetDpiForSystem")
    If fn : sysdpi = CallFunctionFast(fn) : EndIf
    CloseLibrary(lib)
  EndIf
  If sysdpi > 0 : sc = sysdpi / 96.0 : EndIf
  ; The work area is PHYSICAL pixels, OpenWindow takes LOGICAL ones.
  SystemParametersInfo_(#SPI_GETWORKAREA, 0, @wa, 0)
  If w > (wa\right - wa\left) / sc - 40 : w = (wa\right - wa\left) / sc - 40 : EndIf
  If h > (wa\bottom - wa\top) / sc - 60 : h = (wa\bottom - wa\top) / sc - 60 : EndIf
  Gl = OpenGLWindow("8086 emulator - PureBasic, Neon Arcade", w, h,
                    #PB_Window_SystemMenu | #PB_Window_ScreenCentered | #PB_Window_SizeGadget | #PB_Window_MinimizeGadget | #PB_Window_MaximizeGadget)
  Win = Util_MainWindowID
  UI_UseCRT = #False                         ; the frame is not drawn through DrawRetroCRT: no barrel-bent pointer
  CtlLoad()
  ScaleFonts(DisplayScale())                 ; Frame() measures s from then on
  PcTextureInit()
  If #CPU_TIMING : PcSoundOpen() : EndIf
  RateWindowStart = ElapsedMilliseconds()
  Repeat
    Repeat
      ev = WindowEvent()
      If ev = #PB_Event_CloseWindow : quit = 1 : EndIf
      If ev = #PB_Event_Menu And EventMenu() = 1001  ; the engine takes Escape as a shortcut: the table says what it is
        k = CtlFind(#PB_Shortcut_Escape, FullScreen)
        If k >= 0 And CtlHitGroup = #CTL_WINDOW
          WindowAction(k)
        ElseIf k >= 0 And PcKeysOn()
          Pc86Key(k) : Pc86Key(k | $80)          ; the shortcut gives one event: press and release
        Else
          KeyCode = #PB_Shortcut_Escape
        EndIf
      EndIf
      If ev = #PB_Event_Gadget And EventGadget() = Gl
        et = EventType()
        If et = #PB_EventType_KeyDown And CtlFind(GetGadgetAttribute(Gl, #PB_OpenGL_Key), FullScreen) >= 0 And CtlHitGroup = #CTL_WINDOW
          WindowAction(CtlFind(GetGadgetAttribute(Gl, #PB_OpenGL_Key), FullScreen))   ; F11
        ElseIf et = #PB_EventType_KeyUp And CtlFind(GetGadgetAttribute(Gl, #PB_OpenGL_Key), FullScreen) >= 0 And CtlHitGroup = #CTL_WINDOW
          ; F11's release
        ElseIf et = #PB_EventType_MouseWheel
          Wheel + GetGadgetAttribute(Gl, #PB_OpenGL_WheelDelta)
        ElseIf PcKeysOn() And (et = #PB_EventType_KeyDown Or et = #PB_EventType_KeyUp)
          k = PcScanCode(GetGadgetAttribute(Gl, #PB_OpenGL_Key), FullScreen)
          If k
            If et = #PB_EventType_KeyUp : k | $80 : EndIf
            Pc86Key(k)
          EndIf
        ElseIf PcKeysOn() And et = #PB_EventType_Input
          ; the key went to the PC
        ElseIf et = #PB_EventType_KeyDown
          KeyCode = GetGadgetAttribute(Gl, #PB_OpenGL_Key)
        ElseIf et = #PB_EventType_Input
          KeyChar = GetGadgetAttribute(Gl, #PB_OpenGL_Input)
        EndIf
      EndIf
    Until ev = 0
    Frame()
    If ShotFrames < 0 Or SynthDone Or FsTestDone : quit = 1 : EndIf
    If Running = 0 : Delay(10) : EndIf
  Until quit
  PcSoundClose()
EndProcedure

UsePNGImageEncoder()
DisInit()
DefaultStream$ = GetPathPart(ProgramFilename()) + #STREAM_DEFAULT$
MachineMap()
MachineReset()
Define rc.i = ConsoleMain()
If rc >= 0
  End rc
EndIf
Define argi.i, arg$, showTests.i, startRun.i, loaded.i
For argi = 0 To CountProgramParameters() - 1
  arg$ = ProgramParameter(argi)
  If LCase(arg$) = "--show-tests"
    showTests = 1
  ElseIf LCase(arg$) = "--run"
    startRun = 1
  ElseIf LCase(arg$) = "--screenshot"
    argi + 1
    ShotPath$ = ProgramParameter(argi)
  ElseIf LCase(arg$) = "--fullscreen-test"
    argi + 1
    FsTestFile$ = ProgramParameter(argi) : FsTestOn = 1
  ElseIf LCase(arg$) = "--fullscreen-shot"
    argi + 1
    FsTestShot$ = ProgramParameter(argi)
  ElseIf LCase(arg$) = "--pointer-test"
    argi + 1
    SynthFile$ = ProgramParameter(argi) : SynthOn = 1 : SynthInit()
  ElseIf LCase(arg$) = "--mute"
    PcSndMuted = 1
  ElseIf LCase(arg$) = "--pc"
    If #CPU_TIMING : MachineKind = 1 : MemTab = 5 : ResetProgram() : EndIf
  ElseIf LoadProgram(arg$)
    loaded = 1 : DisTop = $100
  EndIf
Next
If loaded                           ; after the loop: --pc may follow the file name
  Status$ = "Loaded " + MachineName$ + " (" + Str(MachineLoadBytes) + " bytes)" + LoadText()
EndIf
If showTests : RunTestsInWindow() : EndIf
If startRun
  Running = 1
  If showTests = 0 : LogTab = 0 : EndIf
EndIf
WindowMain()
CompilerEndIf
