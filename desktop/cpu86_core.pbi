  If (~ea << 60) = 0              ; xxxF: maybe a page or segment end
    t = 0
  EndIf
  If t <> 0
    va = PeekA(t + ea) | (PeekA(t + ea + 1) << 8)
  Else
    va = Cpu86Rd16(sb, eo)
  EndIf
  eo = (R(4) - 2) & $FFFF
  R(4) = eo
  ea = SegB(2) + eo
  t = PageW(ea >> 12)
  If (~ea << 60) = 0              ; xxxF: maybe a page or segment end
    t = 0
  EndIf
  If t <> 0
    PokeA(t + ea, va)
    PokeA(t + ea + 1, va >> 8)
  Else
    Cpu86Wr16(SegB(2), eo, va)
  EndIf
  CompilerIf #CPU_TIMING = 1
    Left = Left - (16)
    If Left <= 0
      Goto Done
    EndIf
  CompilerElse
    Left = Left - 1
    If Left = 0
      Goto Done
    EndIf
  CompilerEndIf
  If PIP >= PEnd
    Goto Resync
  EndIf
  ! goto *cpu86_dsp[*(unsigned char*)g_pip];
Done:
  ProcedureReturn Budget - Left
EndProcedure
