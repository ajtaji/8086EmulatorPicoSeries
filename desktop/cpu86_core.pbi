; Generated by tools/gen_cpu.py. Edit the generator, then regenerate.
; Intel 8086 interpreter core, PureBasic (C back end, x64), for the desktop program.
; The same handlers as the Pico core, written with 64-bit flag shifts; the
; computed jumps are C labels-as-values (gcc && and goto *).
; Target: desktop. See README.md for the API, memory map and limits.
;
; Configuration, declared by the including program before XIncludeFile:
;   #CPU_TIMING   0 = budget in instructions, 1 = budget in 8086 clocks
;   #CPU_ASM_TAIL 1 = inline-assembly dispatch tail, 0 = PureMetal Goto
;
; The including program defines four procedures (any order):
;   Cpu86HookRead.i(lin.i)            byte read from a hook page
;   Cpu86HookWrite(lin.i, v.i)        byte write to a hook page
;   Cpu86PortIn.i(port.i, wide.i)     IN: wide = 0 byte, 1 word
;   Cpu86PortOut(port.i, v.i, wide.i) OUT
EnableExplicit

Declare.i Cpu86HookRead(lin.i)
Declare Cpu86HookWrite(lin.i, v.i)
Declare.i Cpu86PortIn(port.i, wide.i)
Declare Cpu86PortOut(port.i, v.i, wide.i)
#CPU_ASM_TAIL = 0

#CPU86_PAGES = 256              ; 1 MB in 4 KB pages
#CPU86_RAM = 0                  ; page kinds
#CPU86_ROM = 1
#CPU86_NONE = 2
#CPU86_HOOK = 3

