  R(4) = eo
  ea = (SegB(2) + eo) & $FFFFF
  t = PageW(ea >> 12)
  If (ea & $FFF) = $FFF
    t = 0
  EndIf
  If eo = $FFFF
    t = 0
  EndIf
  If t <> 0
    PokeA(t + ea, va)
    PokeA(t + ea + 1, va >> 8)
  Else
    Cpu86Wr16(SegB(2), eo, va)
  EndIf
  NextOp(11)
GFFM7:
  t = PageR(ea >> 12)
  If (ea & $FFF) = $FFF
    t = 0
  EndIf
  If eo = $FFFF
    t = 0
  EndIf
  If t <> 0
    va = PeekA(t + ea) | (PeekA(t + ea + 1) << 8)
  Else
    va = Cpu86Rd16(sb, eo)
  EndIf
  eo = (R(4) - 2) & $FFFF
  R(4) = eo
  ea = (SegB(2) + eo) & $FFFFF
  t = PageW(ea >> 12)
  If (ea & $FFF) = $FFF
    t = 0
  EndIf
  If eo = $FFFF
    t = 0
  EndIf
  If t <> 0
    PokeA(t + ea, va)
    PokeA(t + ea + 1, va >> 8)
  Else
    Cpu86Wr16(SegB(2), eo, va)
  EndIf
  NextOp(16)
Done:
  ProcedureReturn Budget - Left
EndProcedure
