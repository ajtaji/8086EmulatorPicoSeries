    Ready = 1
  EndIf
  Budget = n
  Left = n
  Goto Resync

Resync:
  SegD = SegB(3)
  SegS = SegB(2)
  Rep = 0
  If EvPend Or Halted Or (FlagsHi & $100)
    If Cpu86Events() = 0
      Goto Done
    EndIf
  EndIf
  Cpu86Remap()
  Goto Dispatch(PeekA(PIP))

PrefixNext:
  PIP = PIP + 1
  If PIP >= PEndReal
    Cpu86Remap()
  EndIf
  PEnd = 0
  Goto Dispatch(PeekA(PIP))

Ea00:
