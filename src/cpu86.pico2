; ------------------------------------------------------------ the interpreter
; Cpu86Run(n): execute until the budget n is spent (instructions, or clocks
; with #CPU_TIMING = 1). A REP string instruction is one instruction. Returns
; the budget used; stops early when the CPU halts (Halted = 1).
ProcedureRAM.i Cpu86Run(n.i)
  Protected m.i, t.i, ea.i, eo.i, sb.i, va.i, vb.i, vr.i, cnt.i, x.i, y.i
Macro NextOp(c)
  CompilerIf #CPU_TIMING = 1
    Left = Left - (c)
    If Left <= 0
      Goto Done
    EndIf
    CompilerIf #CPU_ASM_TAIL = 1
      ASM Uses PIP, PEnd
        cmp r4, r5
        bhs __ul_cpu86run_resync
        ldrb r0, [r4]
        lsls r0, r0, #2
        ldr r1, =global_dispatch
        ldr r1, [r1, r0]
        bx r1
      EndASM
    CompilerElse
      If PIP >= PEnd
        Goto Resync
      EndIf
      Goto Dispatch(PeekA(PIP))
    CompilerEndIf
  CompilerElse
    CompilerIf #CPU_ASM_TAIL = 1
      ASM Uses Left, PIP, PEnd
        mov r0, r11
        subs r0, #1
        mov r11, r0
        beq __ul_cpu86run_done
        cmp r4, r5
        bhs __ul_cpu86run_resync
        ldrb r0, [r4]
        lsls r0, r0, #2
        ldr r1, =global_dispatch
        ldr r1, [r1, r0]
        bx r1
      EndASM
    CompilerElse
      Left = Left - 1
      If Left = 0
        Goto Done
      EndIf
      If PIP >= PEnd
        Goto Resync
      EndIf
      Goto Dispatch(PeekA(PIP))
    CompilerEndIf
  CompilerEndIf
EndMacro
  If n <= 0
    ProcedureReturn 0
  EndIf
  If Ready = 0
    For InitIndex = 0 To 255
      t = InitIndex ! (InitIndex >> 4)
      t = t ! (t >> 2)
      t = t ! (t >> 1)
      If t & 1
        Par(InitIndex) = 0
      Else
        Par(InitIndex) = 4
      EndIf
    Next
    R8O(0) = 0
    R8O(1) = 2
    R8O(2) = 4
    R8O(3) = 6
    R8O(4) = 1
    R8O(5) = 3
    R8O(6) = 5
    R8O(7) = 7
    Dispatch($00) = ?Op00
    Dispatch($01) = ?Op01
    Dispatch($02) = ?Op02
    Dispatch($03) = ?Op03
    Dispatch($04) = ?Op04
    Dispatch($05) = ?Op05
    Dispatch($06) = ?Op06
    Dispatch($07) = ?Op07
    Dispatch($08) = ?Op08
    Dispatch($09) = ?Op09
    Dispatch($0A) = ?Op0A
    Dispatch($0B) = ?Op0B
    Dispatch($0C) = ?Op0C
    Dispatch($0D) = ?Op0D
    Dispatch($0E) = ?Op0E
    Dispatch($0F) = ?Op0F
    Dispatch($10) = ?Op10
    Dispatch($11) = ?Op11
    Dispatch($12) = ?Op12
    Dispatch($13) = ?Op13
    Dispatch($14) = ?Op14
    Dispatch($15) = ?Op15
    Dispatch($16) = ?Op16
    Dispatch($17) = ?Op17
    Dispatch($18) = ?Op18
    Dispatch($19) = ?Op19
    Dispatch($1A) = ?Op1A
    Dispatch($1B) = ?Op1B
    Dispatch($1C) = ?Op1C
    Dispatch($1D) = ?Op1D
    Dispatch($1E) = ?Op1E
    Dispatch($1F) = ?Op1F
    Dispatch($20) = ?Op20
    Dispatch($21) = ?Op21
    Dispatch($22) = ?Op22
