; Generated by tools/gen_cpu.py. Edit the generator, then regenerate.
; Intel 8086 interpreter core for the Raspberry Pi Pico series, PureMetal.
; Target: rp2350. See README.md for the API, memory map and limits.
;
; Configuration, declared by the including program before XIncludeFile:
;   #CPU_TIMING   0 = budget in instructions, 1 = budget in 8086 clocks
;   #CPU_ASM_TAIL 1 = inline-assembly dispatch tail, 0 = PureMetal Goto
;
; The including program defines four procedures (any order):
;   Cpu86HookRead.i(lin.i)            byte read from a hook page
;   Cpu86HookWrite(lin.i, v.i)        byte write to a hook page
;   Cpu86PortIn.i(port.i, wide.i)     IN: wide = 0 byte, 1 word
;   Cpu86PortOut(port.i, v.i, wide.i) OUT
EnableExplicit

#CPU86_PAGES = 256              ; 1 MB in 4 KB pages
#CPU86_RAM = 0                  ; page kinds
#CPU86_ROM = 1
#CPU86_NONE = 2
#CPU86_HOOK = 3

Global Dim R.u(8)               ; AX CX DX BX SP BP SI DI
Global Dim SegV.u(4)            ; ES CS SS DS
Global Dim SegB.i(4)            ; segment bases (value << 4)
Global Dim PageR.i(#CPU86_PAGES)
Global Dim PageW.i(#CPU86_PAGES)
Global Dim PageK.a(#CPU86_PAGES)
Global Dim PageH.i(#CPU86_PAGES) ; host base of a ROM/RAM page (for slow paths)
Global Dim Dispatch.Label(256)
Global Dim EaTab.Label(256)
Global Dim EaSmall.Label(32)     ; mod * 8 + rm
Global Dim Par.a(256)           ; 4 when the byte has even parity
Global Dim R8O.a(8)             ; byte register -> byte offset in R
Global Dim Buf.a(8)             ; instructions that cross a page or IP wrap
Global EaRet.Label
Global PIP.i, PEnd.i, FZS.i, FC.i, FO.i, Left.i, FA.i
Global PBase.i, PStart.i, PEndReal.i
Global SegD.i, SegS.i, Rep.i
Global FlagsHi.i, DirStep.i, DirStep2.i
Global EvPend.i, IrqVector.i, Halted.i
Global Budget.i, Ready.i, CpuCycles.i, InitIndex.i, Cpu86Fetching.i
ReserveRegister PIP = r4, PEnd = r5, FZS = r8, FC = r9, FO = r10, Left = r11

; EvPend bits: 1 trap armed, 2 NMI, 4 IRQ, 8 inhibit interrupts for one boundary.

Macro Charge(c)
  CompilerIf #CPU_TIMING = 1
    Left = Left - (c)
  CompilerEndIf
EndMacro

; ------------------------------------------------------------ slow memory paths
; Any linear address, any page kind. Hook pages call the program's hooks.
ProcedureRAM.i Cpu86Rd8(lin.i)
  Protected k.i
  lin = lin & $FFFFF
  k = PageK(lin >> 12)
  If k = #CPU86_HOOK
    ProcedureReturn Cpu86HookRead(lin) & 255
  EndIf
  If k = #CPU86_NONE
    ProcedureReturn 255
  EndIf
  ProcedureReturn PeekA(PageH(lin >> 12) + (lin & $FFF))
EndProcedure

ProcedureRAM Cpu86Wr8(lin.i, v.i)
  Protected k.i
  lin = lin & $FFFFF
  k = PageK(lin >> 12)
  If k = #CPU86_RAM
    PokeA(PageH(lin >> 12) + (lin & $FFF), v)
  ElseIf k = #CPU86_HOOK
    Cpu86HookWrite(lin, v & 255)
  EndIf
EndProcedure

; Word at seg:off; the second byte is at seg:(off + 1) & $FFFF, as on the 8086.
ProcedureRAM.i Cpu86Rd16(sb.i, off.i)
  Protected lo.i
  lo = Cpu86Rd8(sb + off)
  ProcedureReturn lo | (Cpu86Rd8(sb + ((off + 1) & $FFFF)) << 8)
EndProcedure

ProcedureRAM Cpu86Wr16(sb.i, off.i, v.i)
  Cpu86Wr8(sb + off, v)
  Cpu86Wr8(sb + ((off + 1) & $FFFF), v >> 8)
EndProcedure

; ------------------------------------------------------------ flags
ProcedureRAM.i Cpu86Flags()
  Protected f.i
  f = FlagsHi
  If FC < 0
    f = f | 1
  EndIf
  f = f | Par((FZS ! (FZS >> 17)) & 255)
  f = f | (FA & $10)
  If (FZS << 15) = 0
    f = f | $40
  EndIf
  If FZS < 0
    f = f | $80
  EndIf
  If FO < 0
    f = f | $800
  EndIf
  ProcedureReturn f
EndProcedure

; Load all flags. Bits 12-15 read as 1 and bits 3 and 5 as 0 on the 8086.
ProcedureRAM Cpu86SetFlags(f.i)
  Protected z.i
  FC = (f & 1) << 31
  FA = f & $10
  FO = (f & $800) << 20
  If f & $40
    z = 0
    If (f & 4) = 0
      z = $20000
    EndIf
  Else
    z = 1
    If f & 4
      z = $20001
    EndIf
  EndIf
  If f & $80
    z = z | $80000000
  EndIf
  FZS = z
  If (f & $300) & ~(FlagsHi & $300)
    PEnd = 0                     ; TF or IF just set: check at the next boundary
  EndIf
  FlagsHi = (f & $0700) | $F002
  If f & $400
    DirStep = -1
    DirStep2 = -2
  Else
    DirStep = 1
    DirStep2 = 2
  EndIf
EndProcedure

; ------------------------------------------------------------ registers
Procedure.i Cpu86GetIP()
  ProcedureReturn ((PIP - PBase) & $FFFF)
EndProcedure

Procedure Cpu86SetIP(ip.i)
  PBase = 0
  PIP = ip & $FFFF
  PEnd = 0
EndProcedure

; Segment register i: 0 ES, 1 CS, 2 SS, 3 DS.
Procedure Cpu86SetSeg(i.i, v.i)
  Protected ip.i
  ip = ((PIP - PBase) & $FFFF)
  SegV(i) = v & $FFFF
  SegB(i) = (v & $FFFF) << 4
  PBase = 0
  PIP = ip
  PEnd = 0
EndProcedure

Procedure.i Cpu86GetSeg(i.i)
  ProcedureReturn SegV(i)
EndProcedure

; ------------------------------------------------------------ memory map
; Pages are 4 KB; lin and bytes must be multiples of 4096. host is the
; address of the first byte (SRAM for RAM, flash or SRAM for ROM).
Procedure Cpu86MapPages(lin.i, bytes.i, kind.i, host.i)
  Protected p.i, n.i
  p = (lin >> 12) & 255
  n = bytes >> 12
  While n > 0
    PageK(p) = kind
    PageH(p) = host
    PageR(p) = 0
    PageW(p) = 0
    If kind = #CPU86_RAM
      PageR(p) = host - (p << 12)
      PageW(p) = host - (p << 12)
    ElseIf kind = #CPU86_ROM
      PageR(p) = host - (p << 12)
    EndIf
    host = host + 4096
    p = (p + 1) & 255
    n = n - 1
  Wend
  PEnd = 0
EndProcedure

Procedure Cpu86MapRam(lin.i, bytes.i, host.i)
  Cpu86MapPages(lin, bytes, #CPU86_RAM, host)
EndProcedure

Procedure Cpu86MapRom(lin.i, bytes.i, host.i)
  Cpu86MapPages(lin, bytes, #CPU86_ROM, host)
EndProcedure

Procedure Cpu86MapHook(lin.i, bytes.i)
  Cpu86MapPages(lin, bytes, #CPU86_HOOK, 0)
EndProcedure

Procedure Cpu86MapNone(lin.i, bytes.i)
  Cpu86MapPages(lin, bytes, #CPU86_NONE, 0)
EndProcedure

; ------------------------------------------------------------ fetch window
; Recompute PIP/PBase/PStart/PEnd for the current CS:IP. Prefix state is
; untouched, so a prefix may call this in the middle of an instruction.
ProcedureRAM Cpu86Remap()
  Protected ip.i, lin.i, p.i, en.i, k.i
  ip = ((PIP - PBase) & $FFFF)
  lin = (SegB(1) + ip) & $FFFFF
  p = PageR(lin >> 12)
  If ip > $FFFA
    p = 0
  EndIf
  If (lin & $FFF) > $FFA
    p = 0
  EndIf
  If p <> 0
    PBase = p + lin - ip
    PIP = p + lin
    PStart = p + (lin & $FF000)
    en = p + (lin | $FFF) - 4
    k = PBase + $FFFB
    If k < en
      en = k
    EndIf
    PEndReal = en
  Else
    Cpu86Fetching = 1           ; hooks: this is an instruction prefetch
    For k = 0 To 5
      Buf(k) = Cpu86Rd8(SegB(1) + ((ip + k) & $FFFF))
    Next
    Cpu86Fetching = 0
    PBase = @Buf(0) - ip
    PIP = @Buf(0)
    PStart = $7FFFFFFF
    PEndReal = PIP + 1
  EndIf
  PEnd = PEndReal
  If FlagsHi & $100
    PEnd = 0
  EndIf
  If EvPend & 11
    PEnd = 0
  EndIf
  If (EvPend & 4) And (FlagsHi & $200)
    PEnd = 0
  EndIf
EndProcedure

; ------------------------------------------------------------ interrupts
; Push FLAGS, CS, IP (the IP of PIP); clear IF and TF; jump through the IVT.
ProcedureRAM Cpu86Interrupt(n.i)
  Protected f.i, ip.i, sp.i, ncs.i, nip.i
  f = Cpu86Flags()
  ip = ((PIP - PBase) & $FFFF)
  sp = (R(4) - 2) & $FFFF
  Cpu86Wr16(SegB(2), sp, f)
  sp = (sp - 2) & $FFFF
  Cpu86Wr16(SegB(2), sp, SegV(1))
  sp = (sp - 2) & $FFFF
  Cpu86Wr16(SegB(2), sp, ip)
  R(4) = sp
  FlagsHi = FlagsHi & ~$300
  EvPend = EvPend & ~1
  nip = Cpu86Rd16(0, (n & 255) << 2)
  ncs = Cpu86Rd16(0, ((n & 255) << 2) + 2)
  SegV(1) = ncs
  SegB(1) = ncs << 4
  PBase = 0
  PIP = nip
  PEnd = 0
EndProcedure

; At an instruction boundary with EvPend or Halted set. Returns 0 when the CPU
; is halted with nothing to wake it.
ProcedureRAM.i Cpu86Events()
  If EvPend & 8
    EvPend = EvPend & ~8
  ElseIf EvPend & 1
    Cpu86Interrupt(1)
  ElseIf EvPend & 2
    EvPend = EvPend & ~2
    Halted = 0
    Cpu86Interrupt(2)
  ElseIf (EvPend & 4) And (FlagsHi & $200)
    EvPend = EvPend & ~4
    Halted = 0
    Cpu86Interrupt(IrqVector)
  EndIf
  If Halted
    ProcedureReturn 0
  EndIf
  If FlagsHi & $100
    EvPend = EvPend | 1
  EndIf
  ProcedureReturn 1
EndProcedure

; Maskable interrupt request: held until IF = 1, then taken through `vector`.
Procedure Cpu86Irq(vector.i)
  IrqVector = vector & 255
  EvPend = EvPend | 4
  PEnd = 0
EndProcedure

Procedure Cpu86IrqCancel()
  EvPend = EvPend & ~4
EndProcedure

Procedure Cpu86Nmi()
  EvPend = EvPend | 2
  PEnd = 0
EndProcedure

; Power-on state: CS:IP = FFFF:0000, other segments 0, FLAGS = F002.
Procedure Cpu86Reset()
  Protected i.i
  For i = 0 To 7
    R(i) = 0
  Next
  For i = 0 To 3
    SegV(i) = 0
    SegB(i) = 0
  Next
  SegV(1) = $FFFF
  SegB(1) = $FFFF0
  Cpu86SetFlags($F002)
  EvPend = 0
  Halted = 0
  Rep = 0
  CpuCycles = 0
  PBase = 0
  PIP = 0
  PEnd = 0
EndProcedure

