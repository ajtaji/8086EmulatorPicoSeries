  NextOp(3)
Op01M:
  t = PageR(ea >> 12)
  If (ea & $FFF) = $FFF
    t = 0
  EndIf
  If eo = $FFFF
    t = 0
  EndIf
  If t <> 0
    va = PeekA(t + ea) | (PeekA(t + ea + 1) << 8)
  Else
    va = Cpu86Rd16(sb, eo)
  EndIf
  vb = R((m >> 3) & 7)
  vr = va + vb
  FC = vr << 15
  FO = ((va ! vr) & (vb ! vr)) << 16
  FA = va ! vb ! vr
  FZS = (vr << 16) >> 16
  t = PageW(ea >> 12)
  If (ea & $FFF) = $FFF
    t = 0
  EndIf
  If eo = $FFFF
    t = 0
  EndIf
  If t <> 0
    PokeA(t + ea, vr)
    PokeA(t + ea + 1, vr >> 8)
  Else
    Cpu86Wr16(sb, eo, vr)
  EndIf
  NextOp(16)
