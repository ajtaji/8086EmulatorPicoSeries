Op00:
  m = PeekA(PIP + 1)
  If m < $C0
    EaRet = ?Op00M
    Goto EaTab(m)
  EndIf
  PIP = PIP + 2
  va = PeekA(@R(0) + R8O(m & 7))
  vb = PeekA(@R(0) + R8O((m >> 3) & 7))
  vr = va + vb
  FC = vr << 23
  FO = ((va ! vr) & (vb ! vr)) << 24
  FA = va ! vb ! vr
  FZS = (vr << 24) >> 24
  PokeA(@R(0) + R8O(m & 7), vr)
  NextOp(3)
Op00M:
  t = PageR(ea >> 12)
  If t <> 0
    va = PeekA(t + ea)
  Else
    va = Cpu86Rd8(ea)
  EndIf
  vb = PeekA(@R(0) + R8O((m >> 3) & 7))
  vr = va + vb
  FC = vr << 23
  FO = ((va ! vr) & (vb ! vr)) << 24
  FA = va ! vb ! vr
  FZS = (vr << 24) >> 24
  t = PageW(ea >> 12)
  If t <> 0
    PokeA(t + ea, vr)
  Else
    Cpu86Wr8(ea, vr)
  EndIf
  NextOp(16)
